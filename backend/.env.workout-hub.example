# Production settings (copy to your secret manager; never commit real values)
WORKOUT_HUB_ENV=production
WORKOUT_HUB_MASTER_KEY=replace-with-output-of-python-cryptography-fernet-generate-key
WORKOUT_HUB_DB_PATH=/var/lib/workout-hub/workout_hub.db
WORKOUT_HUB_ALLOWED_ORIGINS=https://workouts.example.com
WORKOUT_HUB_HOST=127.0.0.1
WORKOUT_HUB_PORT=8787
WORKOUT_HUB_LOG_LEVEL=info

# Frontend build setting
PUBLIC_WORKOUT_HUB_API_URL=https://api.example.com/api/workout-hub
