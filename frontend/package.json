{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "test:workout-hub": "node --test src/lib/workoutHub.test.mjs",
    "snapshot:fitness-podcast-feed": "node ./scripts/snapshot-fitness-podcast-feed.mjs",
    "refresh:homepage-hero-video": "node ./scripts/refresh-homepage-hero-video.mjs",
    "refresh:homepage-data": "node ./scripts/refresh-homepage-fitness-data.mjs",
    "cloudflare:redirect:podcast-transcripts": "node ./scripts/setup-cloudflare-transcript-redirect.mjs",
    "audit:indexability": "node ./scripts/audit-indexability.mjs",
    "report:gsc": "node ./scripts/gsc-weekly-report.mjs",
    "collect:clarity": "node ./scripts/clarity-insights.mjs collect",
    "report:clarity": "node ./scripts/clarity-insights.mjs report",
    "submit:gsc-sitemap": "node ./scripts/gsc-submit-sitemap.mjs",
    "translate:blog:one": "node ./scripts/blog-translations.mjs translate-one",
    "translate:blog:status": "node ./scripts/blog-translations.mjs status",
    "translate:blog:promote": "node ./scripts/blog-translations.mjs promote",
    "translate:blog:validate": "node ./scripts/blog-translations.mjs validate-output",
    "translate:blog:quarantine-invalid": "node ./scripts/blog-translations.mjs quarantine-invalid",
    "translate:priority-pages:one": "node ./scripts/priority-page-translations.mjs translate-one",
    "translate:priority-pages:status": "node ./scripts/priority-page-translations.mjs status",
    "translate:priority-pages:promote": "node ./scripts/priority-page-translations.mjs promote",
    "translate:priority-pages:validate": "node ./scripts/priority-page-translations.mjs validate-output",
    "build": "npm run snapshot:fitness-podcast-feed && TOFT_FITNESS_PODCAST_FEED_SNAPSHOT=.cache/fitness-podcast-feed.xml astro build && npx pagefind --site dist && npm run audit:indexability",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.6",
    "astro-seo": "^1.1.0",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
