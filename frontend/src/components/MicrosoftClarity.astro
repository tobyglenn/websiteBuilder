---
// PostHog is the primary analytics tool. Clarity stays only because the daily
// DGX Clarity report (scripts/run-clarity-daily-snapshot.sh) reads its data, so
// it loads after the page has finished loading and the browser is idle.
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || 'y4ha1s1t5s';
---

{clarityId && (
  <script is:inline define:vars={{ clarityId }}>
    (function(c,l,a,r,i){
      if (c[a]) return;
      c[a]=function(){(c[a].q=c[a].q||[]).push(arguments)};
      function inject(){
        var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      }
      function whenIdle(){
        if ("requestIdleCallback" in c) c.requestIdleCallback(inject,{timeout:4000});
        else setTimeout(inject,2000);
      }
      if (l.readyState==="complete") whenIdle();
      else c.addEventListener("load",whenIdle,{once:true});
    })(window, document, "clarity", "script", clarityId);
  </script>
)}
