---
// Shared /search/ page for every locale. Page files under src/pages only pick the language.
import Layout from '../../layouts/Layout.astro';
import { Search as SearchIcon } from 'lucide-react';

type Lang = 'en' | 'de' | 'es' | 'pt' | 'hi';
interface Props {
  lang: Lang;
}

const COPY = {
  "en": {
    "title": "Search - Toby on Fitness Tech",
    "description": "Search videos, blog posts, and gear reviews on TobyOnFitnessTech.",
    "heading": "Search Results",
    "label": "Search videos and articles",
    "submit": "Search videos and articles",
    "submitTitle": "Search",
    "noResults": "No matches found. Try a different keyword.",
    "videos": "Videos",
    "articles": "Articles",
    "prompt": "Enter a search term above to find videos and articles.",
    "loading": "Searching…",
    "found": "Found {total} results for \"{q}\"",
    "failed": "Search could not load. Please try again.",
    "read": "Read Analysis →"
  },
  "de": {
    "title": "Suche - Toby über Fitness-Tech",
    "description": "Suche nach Videos, Blogbeiträgen und Gear-Reviews auf TobyOnFitnessTech.",
    "heading": "Suchergebnisse",
    "label": "Videos und Artikel suchen",
    "submit": "Videos und Artikel suchen",
    "submitTitle": "Videos und Artikel suchen",
    "noResults": "Keine Treffer gefunden. Versuche ein anderes Stichwort.",
    "videos": "Videos",
    "articles": "Artikel",
    "prompt": "Gib oben einen Suchbegriff ein, um Videos und Artikel zu finden.",
    "loading": "Suche läuft…",
    "found": "Gefunden: {total} Ergebnisse für \"{q}\"",
    "failed": "Die Suche konnte nicht geladen werden. Bitte versuche es erneut.",
    "read": "Analyse lesen →"
  },
  "es": {
    "title": "Buscar - Toby sobre tecnología fitness",
    "description": "Busca videos, artículos del blog y reseñas de equipo en TobyOnFitnessTech.",
    "heading": "Resultados de búsqueda",
    "label": "Buscar vídeos y artículos",
    "submit": "Buscar vídeos y artículos",
    "submitTitle": "Buscar vídeos y artículos",
    "noResults": "No se encontraron coincidencias. Prueba con otra palabra clave.",
    "videos": "Videos",
    "articles": "Artículos",
    "prompt": "Ingresa arriba un término de búsqueda para encontrar videos y artículos.",
    "loading": "Buscando…",
    "found": "Se encontraron {total} resultados para \"{q}\"",
    "failed": "No se pudo cargar la búsqueda. Inténtalo de nuevo.",
    "read": "Leer análisis →"
  },
  "pt": {
    "title": "Busca - Toby sobre tecnologia fitness",
    "description": "Busque vídeos, posts do blog e análises de equipamentos no TobyOnFitnessTech.",
    "heading": "Resultados da busca",
    "label": "Pesquisar vídeos e artigos",
    "submit": "Pesquisar vídeos e artigos",
    "submitTitle": "Pesquisar vídeos e artigos",
    "noResults": "Nenhuma correspondência encontrada. Tente outra palavra-chave.",
    "videos": "Vídeos",
    "articles": "Artigos",
    "prompt": "Digite acima um termo de busca para encontrar vídeos e artigos.",
    "loading": "Buscando…",
    "found": "Encontrados {total} resultados para \"{q}\"",
    "failed": "Não foi possível carregar a busca. Tente novamente.",
    "read": "Ler análise →"
  },
  "hi": {
    "title": "खोज - Toby on Fitness Tech",
    "description": "TobyOnFitnessTech पर वीडियो, ब्लॉग पोस्ट और गियर रिव्यू खोजें।",
    "heading": "खोज परिणाम",
    "label": "वीडियो और लेख खोजें",
    "submit": "वीडियो और लेख खोजें",
    "submitTitle": "वीडियो और लेख खोजें",
    "noResults": "कोई मेल नहीं मिला। कोई दूसरा कीवर्ड आज़माएँ।",
    "videos": "वीडियो",
    "articles": "लेख",
    "prompt": "वीडियो और लेख खोजने के लिए ऊपर खोज शब्द दर्ज करें।",
    "loading": "खोज जारी है…",
    "found": "\"{q}\" के लिए {total} परिणाम मिले",
    "failed": "खोज लोड नहीं हो सकी। कृपया फिर से प्रयास करें।",
    "read": "विश्लेषण पढ़ें →"
  }
} as const;

const { lang } = Astro.props;
const t = COPY[lang];
const action = lang === 'en' ? '/search/' : `/${lang}/search/`;
---

<Layout title={t.title} description={t.description} noindex={true}>
  <div class="container mx-auto px-4 py-6 min-h-[60vh]">
    <div data-page-intro class="mb-4 border-b border-neutral-800 pb-8">
      <h1 data-page-title class="text-3xl md:text-4xl font-bold mb-4 flex items-center gap-3">
        <SearchIcon size={32} class="text-blue-500" /> {t.heading}
      </h1>
      <p id="search-summary" class="text-neutral-400 text-lg">{t.prompt}</p>
      <form
        id="standalone-search-form"
        data-copy-prompt={t.prompt}
        data-copy-loading={t.loading}
        data-copy-found={t.found}
        data-copy-failed={t.failed}
        data-copy-read={t.read}
        action={action}
        method="get"
        class="mt-6 flex max-w-2xl gap-2"
      >
        <label for="standalone-query" class="sr-only">{t.label}</label>
        <input id="standalone-query" name="q" type="search" maxlength="120" class="min-w-0 flex-1 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-white" />
        <button type="submit" aria-label={t.submit} title={t.submitTitle} class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-blue-600 text-white hover:bg-blue-500">
          <SearchIcon size={20} />
        </button>
      </form>
    </div>

    <div id="no-results" class="hidden text-center py-12 bg-neutral-900/50 rounded-xl border border-neutral-800 border-dashed">
      <p class="text-neutral-500 text-lg">{t.noResults}</p>
    </div>

    <div id="results-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div id="video-results-section" class="hidden">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#ef4444" class="inline"><polygon points="5,3 19,12 5,21"/></svg>
          {t.videos}
        </h2>
        <div id="video-results" class="space-y-6"></div>
      </div>

      <div id="blog-results-section" class="hidden">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          {t.articles}
        </h2>
        <div id="blog-results" class="space-y-6"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import '../../lib/standaloneSearch.js';
</script>
