const { lang } = Astro.props;
const t = COPY[lang];
const prefix = lang === 'en' ? '' : `/${lang}`;


const {
  fitnessAge,
  actualAge,
  ageDelta,
  avgHRV,
  avgRHR,
  avgRecovery,
  weeklyWorkouts,
  runningMiles,
  cardioScore,
  workoutConsistency,
  compositeScore,
  avgPaceMinPerMile,
  dataWindows,
} = FITNESS_AGE_DATA;

const deltaLabel = ageDelta > 0 ? t.younger : ageDelta < 0 ? t.older : t.same;
const deltaAbs = Math.abs(ageDelta);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.s1,
  description:
    t.s2,
  totalTime: 'P1D',
  tool: [
    { '@type': 'HowToTool', name: t.s3 },
    { '@type': 'HowToTool', name: t.s4 },
  ],
  step: [
    { '@type': 'HowToStep', name: t.step1Name, text: t.step1Text },
    { '@type': 'HowToStep', name: t.step2Name, text: t.step2Text },
    { '@type': 'HowToStep', name: t.step3Name, text: t.step3Text },
    { '@type': 'HowToStep', name: t.step4Name, text: t.step4Text },
  ],
};
---

<Layout
  title={t.s5}
  description={t.s6}
  breadcrumbs={[{ name: t.home, url: `${prefix}/` }, { name: t.crumb, url: `${prefix}/fitness-age` }]}
  jsonLd={jsonLd}
>

  <div class="bg-neutral-950 min-h-screen text-white pb-20">
    <section data-page-intro class="pt-6 pb-6 px-4">
      <div class="max-w-6xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3 py-1 text-sm rounded-full bg-blue-500/20 text-blue-400 mb-4">
          <Gauge class="w-4 h-4" />
          {t.s7}
        </span>
        <h1 data-page-title class="text-4xl md:text-5xl font-bold mb-3">{t.s8}</h1>
        <p class="text-neutral-400 text-lg max-w-2xl">
          {t.s9}
        </p>

        <div class="mt-8 bg-neutral-900 border border-neutral-800 rounded-2xl p-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div>
            <p class="text-neutral-400 text-sm uppercase tracking-wide">{t.s10}</p>
            <p class="text-6xl font-extrabold text-blue-400 leading-none mt-2">{fitnessAge}</p>
          </div>
          <div class="text-neutral-300">
            <p class="text-sm">{t.s11}: <span class="text-white font-semibold">{actualAge}</span></p>
            <p class="mt-1 text-lg font-semibold flex items-center gap-2">
              {ageDelta > 0 ? <ArrowDown class="w-5 h-5 text-green-400" /> : ageDelta < 0 ? <ArrowUp class="w-5 h-5 text-yellow-400" /> : <Equal class="w-5 h-5 text-blue-400" />}
              {deltaAbs} {t.s12} {deltaLabel}
            </p>
            <p class="text-neutral-500 text-sm mt-1">{t.s13}: {compositeScore}/100</p>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 pb-10">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
          <p class="text-neutral-400 text-sm flex items-center gap-2"><HeartPulse class="w-4 h-4" /> {t.s14}</p>
          <p class="text-3xl font-bold mt-2">{avgHRV}<span class="text-neutral-500 text-lg"> ms</span></p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
          <p class="text-neutral-400 text-sm flex items-center gap-2"><Activity class="w-4 h-4" /> {t.s15}</p>
          <p class="text-3xl font-bold mt-2">{avgRHR}<span class="text-neutral-500 text-lg"> bpm</span></p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
          <p class="text-neutral-400 text-sm flex items-center gap-2"><Zap class="w-4 h-4" /> {t.s16}</p>
          <p class="text-3xl font-bold mt-2">{avgRecovery}<span class="text-neutral-500 text-lg"> /100</span></p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
          <p class="text-neutral-400 text-sm flex items-center gap-2"><CalendarCheck2 class="w-4 h-4" /> {t.s17}</p>
          <p class="text-3xl font-bold mt-2">{weeklyWorkouts}</p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
          <p class="text-neutral-400 text-sm flex items-center gap-2"><Route class="w-4 h-4" /> {t.s18}</p>
          <p class="text-3xl font-bold mt-2">{runningMiles}<span class="text-neutral-500 text-lg"> /12{t.s19}</span></p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5">
          <p class="text-neutral-400 text-sm flex items-center gap-2"><Gauge class="w-4 h-4" /> {t.s20}</p>
          <p class="text-3xl font-bold mt-2 text-blue-400">{cardioScore}<span class="text-neutral-500 text-lg"> /100</span></p>
        </div>
      </div>
    </section>

    <section class="px-4 pb-10">
      <div class="max-w-6xl mx-auto bg-neutral-900 border border-neutral-800 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-4">{t.s21}</h2>
        <div class="grid md:grid-cols-2 gap-6 text-neutral-300">
          <div>
            <p class="font-semibold text-white mb-2">{t.s22}</p>
            <ul class="space-y-2 list-disc list-inside">
              <li>{t.whoopWindow} {dataWindows.whoopDays} {t.days}</li>
              <li>{t.runningWindow} {dataWindows.runningDays} {t.days}</li>
              <li>{t.consistency} {workoutConsistency}{t.consistencyTail}</li>
              <li>{t.avgPace} {avgPaceMinPerMile > 0 ? `${avgPaceMinPerMile} min/mi` : t.na}</li>
            </ul>
          </div>
          <div>
            <p class="font-semibold text-white mb-2">{t.s23}</p>
            <ul class="space-y-2 list-disc list-inside">
              <li>{t.s24}</li>
              <li>{t.s25}</li>
              <li>{t.s26}</li>
              <li>{t.s27}</li>
              <li>{t.s28}</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 pb-20">
      <div class="max-w-6xl mx-auto bg-gradient-to-r from-blue-900/25 to-sky-900/20 border border-blue-800/30 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-3">{t.s29}</h2>
        <p class="text-neutral-300 max-w-3xl">
          {t.s30}
          <span class="text-blue-400 font-semibold"> {deltaAbs} {t.years} {deltaLabel}</span> {t.thanChrono}{' '}
          {t.s31}
        </p>
      </div>
    </section>
  </div>

</Layout>
