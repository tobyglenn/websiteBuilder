  "hi": {
    "s1": "WHOOP रिकवरी डेटा | TobyOnFitnessTech",
    "s2": "WHOOP रिकवरी स्कोर, HRV ट्रेंड, नींद प्रदर्शन और Toby के वास्तविक प्रशिक्षण का स्ट्रेन डेटा लाइव देखें। रोज़ाना अपडेट किया जाता है।",
    "s3": "रिकवरी डेटा",
    "s4": "रातें ट्रैक की गईं",
    "s5": "WHOOP रिकवरी",
    "s6": "मेरे WHOOP 4.0 का वास्तविक रिकवरी डेटा — नींद-आधारित रिकवरी स्कोर, HRV, RHR और स्ट्रेन विश्लेषण।",
    "s7": "औसत रिकवरी",
    "s8": "औसत HRV",
    "s9": "औसत RHR",
    "s10": "नींद प्रदर्शन",
    "s11": "ग्रीन दिन",
    "s12": "कुल दिन",
