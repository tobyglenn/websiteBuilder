---
import Layout from '../../layouts/Layout.astro';
import { Activity, Heart, Moon, TrendingUp, Zap, Clock } from 'lucide-react';
import {
  RECOVERY_RECORDS,
  AVG_RECOVERY,
  AVG_HRV,
  AVG_RHR,
  AVG_SLEEP_PERF,
  TOTAL_DAYS,
  RECENT_RECORDS,
  TREND_DATA,
  RECOVERY_BREAKDOWN,
  LAST_SYNCED,
} from '../../data/whoop.js';

// Shared page for every locale; files under src/pages only pick the language.
type Lang = 'de' | 'es' | 'pt' | 'hi';
interface Props {
