---
import Layout from '../layouts/Layout.astro';
import {
  getLocalizedBlogPosts,
  type BlogTranslationLocale,
} from '../lib/localizedBlogPosts';

interface Props {
  locale: BlogTranslationLocale;
}

const { locale } = Astro.props;

const UI = {
  de: {
    title: 'Analysen',
    description: 'Unabhängige Analysen zu Fitness-Technologie, Training und Erholung, gestützt auf echte Nutzungsdaten.',
    eyebrow: 'Toby über Fitness-Technologie',
    search: 'Analysen durchsuchen',
    all: 'Alle',
    featured: 'Im Fokus',
    latest: 'Neueste Analysen',
    more: 'Weitere Analysen',
    read: 'Analyse lesen',
    readTime: 'Min. Lesezeit',
    empty: 'Noch keine übersetzten Analysen verfügbar.',
    noResults: 'Keine passenden Analysen gefunden.',
    dateLocale: 'de-DE',
    language: 'de-DE',
  },
  es: {
    title: 'Análisis',
    description: 'Análisis independientes sobre tecnología fitness, entrenamiento y recuperación, basados en datos de uso reales.',
    eyebrow: 'Toby sobre tecnología fitness',
    search: 'Buscar análisis',
    all: 'Todos',
    featured: 'Destacado',
    latest: 'Análisis recientes',
    more: 'Más análisis',
    read: 'Leer el análisis',
    readTime: 'min de lectura',
    empty: 'Todavía no hay análisis traducidos disponibles.',
    noResults: 'No se encontraron análisis coincidentes.',
    dateLocale: 'es-ES',
    language: 'es-ES',
  },
  pt: {
    title: 'Análises',
    description: 'Análises independentes sobre tecnologia fitness, treino e recuperação, baseadas em dados reais de uso.',
    eyebrow: 'Toby sobre tecnologia fitness',
    search: 'Buscar análises',
    all: 'Todas',
    featured: 'Em destaque',
    latest: 'Análises recentes',
    more: 'Mais análises',
    read: 'Ler a análise',
    readTime: 'min de leitura',
    empty: 'Ainda não há análises traduzidas disponíveis.',
    noResults: 'Nenhuma análise correspondente foi encontrada.',
    dateLocale: 'pt-BR',
    language: 'pt-BR',
  },
  hi: {
    title: 'विश्लेषण',
    description: 'वास्तविक उपयोग डेटा पर आधारित फिटनेस तकनीक, प्रशिक्षण और रिकवरी के स्वतंत्र विश्लेषण।',
    eyebrow: 'फिटनेस तकनीक पर टोबी',
    search: 'विश्लेषण खोजें',
    all: 'सभी',
    featured: 'प्रमुख',
    latest: 'नवीनतम विश्लेषण',
    more: 'और विश्लेषण',
    read: 'विश्लेषण पढ़ें',
    readTime: 'मिनट में पढ़ें',
    empty: 'अभी कोई अनुवादित विश्लेषण उपलब्ध नहीं है।',
    noResults: 'कोई मिलता-जुलता विश्लेषण नहीं मिला।',
    dateLocale: 'hi-IN',
    language: 'hi-IN',
  },
} as const;

const ui = UI[locale];
const posts = getLocalizedBlogPosts(locale);
const featuredPost = posts[0];
const latestPosts = posts.slice(1, 5);
const remainingPosts = posts.slice(5);
const categoryLabels = new Map<string, string>();
for (const post of posts) {
  if (!categoryLabels.has(post.categoryKey)) categoryLabels.set(post.categoryKey, post.category);
}
const categories = [...categoryLabels.entries()].map(([key, label]) => ({ key, label }));

const readTime = (content = '') => Math.max(1, Math.round(content.split(/\s+/).filter(Boolean).length / 200));
const formatDate = (value = '') => {
  const timestamp = Date.parse(/^\d{4}-\d{2}-\d{2}$/.test(value) ? `${value}T12:00:00Z` : value);
  return Number.isNaN(timestamp)
    ? value
    : new Date(timestamp).toLocaleDateString(ui.dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
};
const articleUrl = (slug: string) => `/${locale}/blog/${slug}/`;
const absoluteArticleUrl = (slug: string) => `https://tobyonfitnesstech.com${articleUrl(slug)}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: ui.title,
  description: ui.description,
  inLanguage: ui.language,
  url: `https://tobyonfitnesstech.com/${locale}/blog/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title,
      url: absoluteArticleUrl(post.slug),
    })),
  },
};
---

<Layout
  title={`${ui.title} - TobyOnFitnessTech`}
  description={ui.description}
  lang={locale}
  translationBase="/blog/"
  jsonLd={schema}
  breadcrumbs={[
    { name: ui.eyebrow, url: `/${locale}/` },
    { name: ui.title, url: `/${locale}/blog/` },
  ]}
>
  <main class="min-h-screen bg-neutral-950 pb-24 pt-24 md:pt-32" data-pagefind-body>
    <section class="border-b border-neutral-800">
      <div class="container mx-auto max-w-6xl px-4 pb-12">
        <p class="mb-3 text-xs font-bold uppercase text-blue-400">{ui.eyebrow}</p>
        <h1 class="text-4xl font-black text-white md:text-6xl">{ui.title}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-300">{ui.description}</p>

        <div class="mt-8 max-w-xl">
          <label for={`blog-search-${locale}`} class="sr-only">{ui.search}</label>
          <input
            id={`blog-search-${locale}`}
            type="search"
            placeholder={ui.search}
            class="w-full rounded-md border border-neutral-700 bg-neutral-900 px-4 py-3 text-white outline-none transition-colors placeholder:text-neutral-500 focus:border-blue-500"
            data-blog-search
          />
        </div>

        {categories.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2" aria-label={ui.title}>
            <button class="category-filter rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white" data-category="" type="button">
              {ui.all}
            </button>
            {categories.map((category) => (
              <button class="category-filter rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm font-semibold text-neutral-300 hover:border-neutral-500 hover:text-white" data-category={category.key} type="button">
                {category.label}
              </button>
            ))}
          </div>
        )}
      </div>
    </section>

    <div class="container mx-auto max-w-6xl px-4 py-12" data-blog-index>
      {featuredPost ? (
        <>
          <section class="grid gap-8 border-b border-neutral-800 pb-12 lg:grid-cols-[minmax(0,1.7fr)_minmax(260px,0.8fr)]" data-lead-section>
            <article
              class="group grid overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 md:grid-cols-[minmax(240px,0.9fr)_minmax(0,1.1fr)]"
              data-post-card
              data-category={featuredPost.categoryKey}
              data-search={`${featuredPost.title} ${featuredPost.excerpt}`.toLocaleLowerCase(locale)}
            >
              <a href={articleUrl(featuredPost.slug)} class="block min-h-56 bg-neutral-800">
                {featuredPost.image
                  ? <img src={featuredPost.image} alt="" class="h-full w-full object-cover" loading="eager" />
                  : <div class="flex h-full min-h-56 items-center justify-center px-6 text-center text-sm font-bold uppercase text-neutral-500">{featuredPost.category}</div>}
              </a>
              <div class="flex flex-col p-7">
                <div class="mb-4 flex flex-wrap gap-3 text-xs font-semibold text-neutral-500">
                  <span class="text-blue-400">{ui.featured}</span>
                  <span>{formatDate(featuredPost.published_at)}</span>
                  <span>{readTime(featuredPost.content)} {ui.readTime}</span>
                </div>
                <h2 class="text-2xl font-black leading-tight text-white transition-colors group-hover:text-blue-400 md:text-3xl">
                  <a href={articleUrl(featuredPost.slug)}>{featuredPost.title}</a>
                </h2>
                <p class="mt-4 flex-1 leading-relaxed text-neutral-300">{featuredPost.excerpt}</p>
                <a href={articleUrl(featuredPost.slug)} class="mt-6 font-bold text-blue-400 hover:text-blue-300">{ui.read} &rarr;</a>
              </div>
            </article>

            <aside>
              <h2 class="mb-3 text-xs font-bold uppercase text-neutral-500">{ui.latest}</h2>
              <div class="divide-y divide-neutral-800">
                {latestPosts.map((post) => (
                  <article
                    class="py-4"
                    data-post-card
                    data-category={post.categoryKey}
                    data-search={`${post.title} ${post.excerpt}`.toLocaleLowerCase(locale)}
                  >
                    <p class="mb-2 text-xs font-semibold text-blue-400">{post.category}</p>
                    <h3 class="font-bold leading-snug text-white hover:text-blue-400"><a href={articleUrl(post.slug)}>{post.title}</a></h3>
                    <p class="mt-2 text-xs text-neutral-500">{formatDate(post.published_at)}</p>
                  </article>
                ))}
              </div>
            </aside>
          </section>

          {remainingPosts.length > 0 && (
            <section class="pt-12">
              <h2 class="mb-6 text-xs font-bold uppercase text-neutral-500">{ui.more}</h2>
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {remainingPosts.map((post) => (
                  <article
                    class="group flex flex-col rounded-lg border border-neutral-800 bg-neutral-900 p-6"
                    data-post-card
                    data-category={post.categoryKey}
                    data-search={`${post.title} ${post.excerpt}`.toLocaleLowerCase(locale)}
                  >
                    <p class="mb-3 text-xs font-semibold text-blue-400">{post.category}</p>
                    <h3 class="text-xl font-bold leading-snug text-white transition-colors group-hover:text-blue-400">
                      <a href={articleUrl(post.slug)}>{post.title}</a>
                    </h3>
                    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-neutral-400">{post.excerpt}</p>
                    <p class="mt-5 text-xs text-neutral-500">{formatDate(post.published_at)} · {readTime(post.content)} {ui.readTime}</p>
                  </article>
                ))}
              </div>
            </section>
          )}
        </>
      ) : (
        <p class="py-20 text-center text-neutral-400">{ui.empty}</p>
      )}

      <p class="hidden py-20 text-center text-neutral-400" data-no-results>{ui.noResults}</p>
    </div>
  </main>
</Layout>

<script>
  const initializeLocalizedBlogIndex = () => {
    const root = document.querySelector('[data-blog-index]');
    const search = document.querySelector('[data-blog-search]');
    if (!(root instanceof HTMLElement) || !(search instanceof HTMLInputElement)) return;

    const cards = [...root.querySelectorAll('[data-post-card]')];
    const filters = [...document.querySelectorAll('.category-filter')];
    const leadSection = root.querySelector('[data-lead-section]');
    const noResults = root.querySelector('[data-no-results]');
    let activeCategory = '';

    const applyFilters = () => {
      const query = search.value.trim().toLocaleLowerCase();
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const categoryMatches = !activeCategory || card.dataset.category === activeCategory;
        const searchMatches = !query || (card.dataset.search || '').includes(query);
        const matches = categoryMatches && searchMatches;
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (leadSection instanceof HTMLElement) leadSection.style.display = visible ? '' : 'none';
      if (noResults instanceof HTMLElement) noResults.classList.toggle('hidden', visible > 0 || cards.length === 0);
    };

    for (const filter of filters) {
      filter.addEventListener('click', () => {
        if (!(filter instanceof HTMLButtonElement)) return;
        activeCategory = filter.dataset.category || '';
        for (const button of filters) {
          button.classList.toggle('bg-blue-600', button === filter);
          button.classList.toggle('text-white', button === filter);
          button.classList.toggle('border', button !== filter);
          button.classList.toggle('border-neutral-700', button !== filter);
          button.classList.toggle('bg-neutral-900', button !== filter);
          button.classList.toggle('text-neutral-300', button !== filter);
        }
        applyFilters();
      });
    }
    search.addEventListener('input', applyFilters);
  };

  document.addEventListener('astro:page-load', initializeLocalizedBlogIndex);
  initializeLocalizedBlogIndex();
</script>
