---
import Layout from '../../layouts/Layout.astro';
import GameVideo from './GameVideo.astro';
import JournalCard from './JournalCard.astro';
import { storiesFor, releasesFor, mediaFor, journalHref, gameHref, playHref, formatDate } from '../../lib/gameJournal.mjs';
import '../../styles/game-showcase.css';
const { game } = Astro.props;
const stories = storiesFor(game.slug);
const releases = releasesFor(game.slug);
const videos = mediaFor(game.mediaIds);
const latest = releases[0];
const schema = {'@context':'https://schema.org','@type':'VideoGame',name:game.title,description:game.summary,url:`https://tobyonfitnesstech.com${gameHref(game)}`,image:`https://tobyonfitnesstech.com${game.hero.src}`,gamePlatform:'Roblox',sameAs:playHref(game)};
---
<Layout title={`${game.title} — Play, Watch & Follow the Build | Toby on Fitness Tech`} description={game.summary} image={game.hero.src} jsonLd={schema} breadcrumbs={[{name:'Home',url:'/'},{name:'Games',url:'/games/'},{name:game.title,url:gameHref(game)}]}>
<div class:list={['game-world',game.accent]} data-pagefind-body data-pagefind-filter="type:Games" data-game-showcase={game.slug}>
<div class="gw-wrap">
  <div class="gw-top"><a href="/games/">← Our Roblox worlds</a><a href="/games/journal/">The development journal ↗</a></div>
  <header class="gw-hero">
    <div><p class="gw-eyebrow">{game.eyebrow}</p><p class="gw-name">{game.title}</p><h1>{game.headline}</h1><p class="gw-lead">{game.summary}</p>
      <div class="gw-actions"><a class="gw-button primary" href={playHref(game)} target="_blank" rel="noopener noreferrer" data-analytics-event="project_destination_click" data-analytics-content-slug={game.slug} data-analytics-content-title={game.title}>Play on Roblox ↗</a><a class="gw-button" href="#watch">Watch {game.slug === 'monstrum-world' ? 'the trailer' : 'the game'} ↓</a></div>
      {latest && <p class="gw-release-latest">From the release journal · <a href={journalHref(latest)}>{latest.title} →</a></p>}
    </div>
    <figure class="gw-art"><img src={game.hero.src} alt={game.hero.alt} width="1200" height="900" fetchpriority="high"/><figcaption class="gw-caption">{game.hero.caption}</figcaption></figure>
  </header>
  <div class="gw-stats">{game.stats.map(([value,label]) => <div class="gw-stat"><strong>{value}</strong><span>{label}</span></div>)}</div>
  <nav class="gw-nav" aria-label={`${game.title} sections`}><a href="#world">Explore the world</a><a href="#watch">Watch</a><a href="#making">How it comes to life</a><a href="#updates">Release journal</a><a href="#start">Start playing</a></nav>
  <section id="world" class="gw-section">
    <div class="gw-intro"><div><p class="gw-eyebrow">Inside the game</p><h2>{game.slug === 'wild-rebellion' ? 'Her characters. Your adventure.' : 'More than a collection. A team.'}</h2></div><div>{game.intro.map(p => <p>{p}</p>)}</div></div>
    {game.features.map((feature,index) => <article class="gw-feature"><figure><img src={feature.image.src} alt={feature.image.alt} width="800" height="500" loading="lazy"/><figcaption class="gw-caption">{feature.image.caption}</figcaption></figure><div><p class="gw-eyebrow">0{index + 1} / Explore</p><h3>{feature.title}</h3><p>{feature.text}</p></div></article>)}
    <div class="gw-cast">{game.characters.map(([name,description]) => <div><h3>{name}</h3><p>{description}</p></div>)}</div>
  </section>
  <section id="watch" class="gw-section"><div class="gw-heading"><div><p class="gw-eyebrow">See the world in motion</p><h2>{game.slug === 'wild-rebellion' ? 'Play it. Explain it. Build it.' : 'Meet Monstrum World.'}</h2></div><p>{game.slug === 'wild-rebellion' ? 'A full family play session, Lilly’s original ideas, and a look behind the build.' : 'The official trailer introduces the adventure. The release journal below follows what has changed since.'}</p></div>
    {videos.length > 0 && <div class="gw-featured-video"><GameVideo video={videos[0]}/></div>}
    <div class="gw-grid">{videos.slice(1).map(video => <GameVideo video={video}/>)}</div>
  </section>
  <section id="making" class="gw-section"><div class="gw-heading"><div><p class="gw-eyebrow">Building our games</p><h2>How a world comes to life.</h2></div><p>{game.creation}</p></div><div class="gw-grid">{stories.filter(s=>s.kind === 'making-of').map(entry=><JournalCard entry={entry}/>)}{latest && <JournalCard entry={latest}/>}</div></section>
  <section id="updates" class="gw-section"><div class="gw-heading"><div><p class="gw-eyebrow">The release journal</p><h2>A world that keeps growing.</h2></div><p>Dated stories about published updates: what changed, why it matters, and what to try next.</p></div>
    {releases.map(entry=><article class="gw-release"><div><span class="gw-version">v{entry.version}</span><time datetime={entry.date}>{formatDate(entry.date)}</time></div><div><h3><a href={journalHref(entry)}>{entry.title}</a></h3><p>{entry.summary}</p><a class="gw-text-link" href={journalHref(entry)} data-analytics-event="content_card_click" data-analytics-content-type="game_release" data-analytics-content-slug={entry.slug}>Explore the update →</a></div></article>)}
    <a class="gw-text-link" href={`/games/journal/#${game.slug}`}>Browse this game’s development stories →</a>
  </section>
  <section id="start" class="gw-section"><div class="gw-heading"><div><p class="gw-eyebrow">Your first visit</p><h2>Find your next adventure.</h2></div></div><div class="gw-steps">{game.steps.map(([title,description])=><article class="gw-step"><h3>{title}</h3><p>{description}</p></article>)}</div><div class="gw-actions"><a class="gw-button primary" href={playHref(game)} target="_blank" rel="noopener noreferrer" data-analytics-event="project_destination_click" data-analytics-content-slug={game.slug}>Open {game.shortTitle || game.title} in Roblox ↗</a></div></section>
  <section class="gw-section gw-faq"><div class="gw-heading"><h2>Before you jump in.</h2></div>{game.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
  <footer class="gw-footer"><p class="gw-eyebrow">Keep exploring</p><div class="gw-actions"><a class="gw-button" href="/games/">Our games →</a><a class="gw-button" href="/games/journal/">Development journal →</a><a class="gw-button" href="/projects/lilly/">Lilly Plays →</a></div></footer>
</div>
</div>
</Layout>
