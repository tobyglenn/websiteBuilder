---
const { video } = Astro.props;
const duration = `${Math.floor(video.durationSeconds / 60)}:${String(video.durationSeconds % 60).padStart(2, '0')}`;
---
<figure class="gw-watch" data-video-location="game_showcase">
  {video.provider === 'local' ? (
    <video controls playsinline preload="none" poster={video.poster} aria-label={video.title} data-game-video={video.id}>
      <source src={video.src} type="video/mp4" />
      <a href={video.src}>Watch {video.title}</a>
    </video>
  ) : (
    <iframe src={`https://www.youtube.com/embed/${video.id}?rel=0&enablejsapi=1`} title={video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen data-analytics-video-id={video.id}></iframe>
  )}
  <figcaption>
    <span class="gw-meta">{video.label} · {duration}</span>
    <h3>{video.title}</h3>
    <p>{video.description}</p>
    {video.provider !== 'local' && <a class="gw-text-link" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer" data-analytics-event="project_video_click" data-analytics-content-slug={video.game} data-analytics-content-title={video.title}>Watch on {video.channelName}’s YouTube ↗</a>}
  </figcaption>
</figure>
<script>
  import { captureEvent } from '../../lib/analytics';
  function bindGameVideos() {
    document.querySelectorAll<HTMLVideoElement>('video[data-game-video]').forEach(video => {
      if (video.dataset.bound) return;
      video.dataset.bound = 'true';
      for (const [native, event] of [['play', 'video_play'], ['pause', 'video_pause'], ['ended', 'video_complete']]) {
        video.addEventListener(native, () => captureEvent(event, { video_id: video.dataset.gameVideo, video_location: 'game_showcase', provider: 'local', current_time: Math.round(video.currentTime) }));
      }
    });
  }
  bindGameVideos();
  document.addEventListener('astro:page-load', bindGameVideos);
</script>
