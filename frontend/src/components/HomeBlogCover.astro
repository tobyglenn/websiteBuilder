---
import { imageVariants } from '../lib/imageVariants.mjs';
import { usesPokemonFeatureImage } from '../lib/pokemonBlogPresentation.mjs';
import { homeBlogCover } from '../lib/homeBlogCovers.mjs';
const { post } = Astro.props;
const photos = homeBlogCover(post);
// Each card splits its width between its photos.
const sizes = photos.length > 1
  ? '(max-width: 767px) 50px, (max-width: 1023px) 25vw, 200px'
  : '(max-width: 767px) 100px, (max-width: 1023px) 50vw, 400px';
---
<div class:list={["home-blog-cover", { "reviewed-pokemon-cover": usesPokemonFeatureImage(post) }]} aria-hidden="true">
  {photos.map(photo => (
    <div style={{ background: photo.background || '#171717' }}>
      <img src={photo.src} {...imageVariants(photo.src, sizes)} alt="" loading="lazy" decoding="async" style={{ objectFit: photo.fit, objectPosition: photo.position }} />
    </div>
  ))}
</div>
<style>
  .home-blog-cover { display: flex; aspect-ratio: 16 / 9; overflow: hidden; background: #171717; }
  .home-blog-cover.reviewed-pokemon-cover { aspect-ratio: 4 / 5; max-height: 420px; }
  .home-blog-cover > div { flex: 1; min-width: 0; overflow: hidden; }
  .home-blog-cover img { display: block; width: 100%; height: 100%; }
</style>
