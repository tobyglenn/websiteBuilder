---
import { Image } from 'astro:assets';
import speediance from '../../public/images/comparison/speediance-v3.png';
import tonal from '../../public/images/gear/tonal.jpg';
import training from '../../public/progress/workout_action.jpg';
import bjj from '../../public/images/about/bjj_day4.jpg';
import wearables from '../../public/images/gear/whoop-5.0.jpg';
import ai from '../../public/images/gear/openclaw-mac-studio.jpg';
import type { ImageMetadata } from 'astro';
import { homeBlogCover } from '../lib/homeBlogCovers.mjs';
const { post } = Astro.props;
const photos = homeBlogCover(post);
const assets: Record<string, ImageMetadata> = {
  '/images/comparison/speediance-v3.png': speediance,
  '/images/gear/tonal.jpg': tonal,
  '/progress/workout_action.jpg': training,
  '/images/about/bjj_day4.jpg': bjj,
  '/images/gear/whoop-5.0.jpg': wearables,
  '/images/gear/openclaw-mac-studio.jpg': ai,
};
---
<div class="home-blog-cover" aria-hidden="true">
  {photos.map(photo => (
    <div style={{ background: photo.background || '#171717' }}>
      <Image src={assets[photo.src]} alt="" loading="lazy" decoding="async" width={800} widths={[400, 800, 1200]} sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw" format="webp" quality={82}
        style={{ objectFit: photo.fit, objectPosition: photo.position }} />
    </div>
  ))}
</div>
<style>
  .home-blog-cover { display: flex; aspect-ratio: 16 / 9; overflow: hidden; background: #171717; }
  .home-blog-cover > div { flex: 1; min-width: 0; overflow: hidden; }
  .home-blog-cover img { display: block; width: 100%; height: 100%; }
</style>
