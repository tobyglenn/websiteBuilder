---
import Layout from '../../layouts/Layout.astro';
import { LISTING_BLOG_POSTS } from '../../lib/blogPosts';
import { ArrowRight, BookOpen, Cpu, FileCode2, Headphones, PlaySquare, Radio, ServerCog } from 'lucide-react';

const agentPosts = LISTING_BLOG_POSTS
  .filter((post) => /openclaw|agentstack|agent stack|local ai|ai fitness assistant|fitness report connector/i.test([
    post.title,
    post.excerpt,
    post.category,
    ...(post.tags || []),
  ].join(' ')))
  .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime())
  .slice(0, 6);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Proyectos de AgentStack, podcast e informes de campo de OpenClaw',
  description: 'Análisis diario de sistemas de IA, integraciones de fitness de OpenClaw, flujos de trabajo de IA local e informes de campo de implementación de Toby Peters.',
  url: 'https://tobyonfitnesstech.com/es/agentstack/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: agentPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title,
      url: `https://tobyonfitnesstech.com/blog/${post.slug}/`,
    })),
  },
};
---

<Layout
  title="AgentStack: Podcast diario de IA y proyectos OpenClaw"
  description="Episodios diarios de AgentStack, integraciones de fitness de OpenClaw, infraestructura de IA local e informes de campo prácticos de los sistemas que Toby está construyendo activamente."
  image="/images/gear/openclaw-mac-studio.jpg"
  jsonLd={pageSchema}
  breadcrumbs={[{ name: 'Inicio', url: '/es/' }, { name: 'AgentStack', url: '/es/agentstack/' }]}

  lang="es"
  translationBase="/agentstack/"
>
  <section class="relative flex min-h-[470px] items-end overflow-hidden border-b border-neutral-800">
    <img
      src="/images/gear/openclaw-mac-studio.jpg"
      alt="Hardware de IA local utilizado para proyectos AgentStack y OpenClaw"
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/75"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/50 to-transparent"></div>
    <div class="container relative z-10 mx-auto px-4 pb-14 pt-32">
      <div class="max-w-3xl">
        <div class="mb-4 flex items-center gap-2 text-sm font-semibold text-fuchsia-300">
          <Cpu size={18} />
          Construido en público
        </div>
        <h1 class="mb-5 text-4xl font-bold leading-tight text-white md:text-6xl">AgentStack</h1>
        <p class="max-w-2xl text-lg leading-relaxed text-neutral-200 md:text-xl">
          El show diario de IA y los sistemas detrás de él: automatizaciones de OpenClaw, conectores de datos de fitness, modelos locales, hardware, evaluaciones y notas honestas de construcción.
        </p>
      </div>
    </div>
  </section>

  <div class="bg-neutral-950">
    <section class="border-b border-neutral-900 py-12">
      <div class="container mx-auto px-4">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <a href="/es/podcasts/agentstack/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-fuchsia-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="agentstack" data-analytics-content-slug="podcast" data-analytics-content-title="AgentStack Daily podcast">
            <Headphones size={23} class="mb-5 text-fuchsia-400" />
            <p class="mb-2 text-xs font-semibold uppercase text-fuchsia-400">Escuchar</p>
            <h2 class="mb-3 text-xl font-bold text-white group-hover:text-fuchsia-300">AgentStack Daily</h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-400">Episodios diarios sobre modelos, hardware, evaluaciones, seguridad y los sistemas que se construyen alrededor de ellos.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-fuchsia-400">Explorar episodios <ArrowRight size={15} /></span>
          </a>
          <a href="/es/blog/openclaw-fitness-reports-garmin-whoop-speediance/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-cyan-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="agentstack" data-analytics-content-slug="fitness-connectors" data-analytics-content-title="fitness connector implementation brief">
            <FileCode2 size={23} class="mb-5 text-cyan-400" />
            <p class="mb-2 text-xs font-semibold uppercase text-cyan-400">Construir</p>
            <h2 class="mb-3 text-xl font-bold text-white group-hover:text-cyan-300">Informe de conector de fitness</h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-400">Una arquitectura lista para agentes para Garmin, WHOOP, Speediance, Cronometer, 8Sleep e informes normalizados.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-400">Leer el informe de implementación <ArrowRight size={15} /></span>
          </a>
          <a href="/es/blog/how-i-built-my-ai-fitness-assistant-with-openclaw/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-emerald-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="agentstack" data-analytics-content-slug="fitness-assistant" data-analytics-content-title="AI fitness assistant field report">
            <ServerCog size={23} class="mb-5 text-emerald-400" />
            <p class="mb-2 text-xs font-semibold uppercase text-emerald-400">Informe de campo</p>
            <h2 class="mb-3 text-xl font-bold text-white group-hover:text-emerald-300">Asistente de fitness con IA</h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-400">Cómo se ensambló el asistente de datos de fitness, qué automatiza y dónde siguen estando los puntos difíciles.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400">Leer la historia de construcción <ArrowRight size={15} /></span>
          </a>
      <a href="/es/videos/#coding" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-rose-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="agentstack" data-analytics-content-slug="videos" data-analytics-content-title="AgentStack videos">
            <PlaySquare size={23} class="mb-5 text-rose-400" />
            <p class="mb-2 text-xs font-semibold uppercase text-rose-400">Ver</p>
            <h2 class="mb-3 text-xl font-bold text-white group-hover:text-rose-300">Vídeos de AgentStack</h2>
            <p class="mb-6 text-sm leading-relaxed text-neutral-400">Tutoriales de construcción, pruebas de modelos, hardware local, fallos y los sistemas detrás del show diario.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-rose-400">Explorar vídeos <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-neutral-900 py-14">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div class="max-w-2xl">
            <p class="mb-2 text-xs font-semibold uppercase text-blue-400">Notas de implementación</p>
            <h2 class="mb-3 text-2xl font-bold text-white md:text-3xl">Informes de campo de OpenClaw y AgentStack</h2>
            <p class="text-neutral-400">La capa escrita duradera detrás del show diario: arquitecturas, modos de fallo, decisiones de conectores y sistemas en funcionamiento.</p>
          </div>
          <a href="/es/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300">Todos los artículos <ArrowRight size={15} /></a>
        </div>

        {agentPosts.length > 0 ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {agentPosts.map((post) => (
              <a
                href={`/blog/${post.slug}/`}
                class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-blue-500/60"
                data-analytics-event="content_card_click"
                data-analytics-content-type="blog"
                data-analytics-content-slug={post.slug}
                data-analytics-content-title={post.title}
              >
                <div class="mb-5 flex items-center justify-between">
                  <BookOpen size={20} class="text-blue-400" />
                  <ArrowRight size={16} class="text-neutral-600 transition-transform group-hover:translate-x-1 group-hover:text-blue-400" />
                </div>
                <p class="mb-2 text-xs font-semibold text-blue-400">{post.category}</p>
                <h3 class="mb-3 line-clamp-3 font-semibold leading-snug text-white group-hover:text-blue-300">{post.title}</h3>
                <p class="line-clamp-3 text-sm leading-relaxed text-neutral-500">{post.excerpt}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-neutral-500">Nuevos informes de campo se están organizando aquí.</p>
        )}
      </div>
    </section>

    <section class="py-14">
      <div class="container mx-auto flex flex-col justify-between gap-8 px-4 md:flex-row md:items-center">
        <div class="max-w-2xl">
          <div class="mb-3 flex items-center gap-2 text-sm font-semibold text-rose-400"><Radio size={18} /> Publicado de forma continua</div>
          <h2 class="mb-3 text-3xl font-bold text-white">Usa el podcast para la historia en movimiento y los informes de campo para la duradera</h2>
          <p class="leading-relaxed text-neutral-400">Los episodios diarios rastrean lo que cambió. Los informes escritos conservan la arquitectura, la evidencia y los detalles de implementación que vale la pena encontrar más tarde.</p>
        </div>
        <a href="/es/podcasts/agentstack/" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-fuchsia-600 px-6 py-3 font-semibold text-white hover:bg-fuchsia-500" data-analytics-event="cta_click" data-analytics-content-type="agentstack" data-analytics-content-slug="podcast" data-analytics-content-title="listen to AgentStack Daily">
          Escuchar AgentStack Daily <ArrowRight size={17} />
        </a>
      </div>
    </section>
  </div>
</Layout>