---
import Layout from '../../layouts/Layout.astro';

// Disciplines are declared once; every colour, label and blurb on the page
// comes from here so nothing has to be kept in sync by hand.
const disciplines = {
  bjj: {
    label: "BJJ",
    daysLabel: "Días de BJJ",
    icon: "🥋",
    stat: "text-orange-400",
    focus: "text-orange-400",
    card: "border-orange-500/30 hover:border-orange-500/60",
    panel: "border-orange-500/20",
    blurb: "El tiempo en el tatami es la prioridad. Técnica, drills y rolling en vivo: el jiu-jitsu me mantiene humilde y es el mejor acondicionamiento anaeróbico que hago.",
  },
  running: {
    label: "Correr",
    daysLabel: "Días de carrera",
    icon: "🏃",
    stat: "text-blue-400",
    focus: "text-blue-400",
    card: "border-blue-500/30 hover:border-blue-500/60",
    panel: "border-blue-500/20",
    blurb: "El cardio es el motor de todo lo demás. Kilómetros suaves, carreras tempo e intervalos construyen la base aeróbica que me sostiene en un rolling largo.",
  },
  lifting: {
    label: "Pesas",
    daysLabel: "Días de pesas",
    icon: "💪",
    stat: "text-purple-400",
    focus: "text-purple-400",
    card: "border-purple-500/30 hover:border-purple-500/60",
    panel: "border-purple-500/20",
    blurb: "Sesiones de cuerpo completo sin piernas (Speediance se encarga de los compuestos pesados). Empuje, tirón e hipertrofia para mantener el cuerpo resistente.",
  },
};

// Weekly training schedule — the single source of truth for this page.
// Stats and priority order below are derived from it, so they can't drift.
const weeklySchedule = [
  {
    day: "Lunes",
    icon: "🥋",
    trains: ["bjj", "lifting"],
    exercises: ["Drills con gi", "Rondas posicionales", "Press de banca", "Jalón al pecho", "Press militar"],
  },
  {
    day: "Martes",
    icon: "🏃",
    trains: ["running"],
    exercises: ["Carrera suave de 5K", "Esfuerzo en zona 2", "Trabajo de movilidad"],
  },
  {
    day: "Miércoles",
    icon: "🥋",
    trains: ["bjj"],
    exercises: ["Drills sin gi", "Rondas de sparring", "Retención de guardia"],
  },
  {
    day: "Jueves",
    icon: "🏃",
    trains: ["running", "lifting"],
    exercises: ["Carrera tempo de 6K", "Peso muerto", "Hip thrust", "Dominadas", "Face pulls"],
  },
  {
    day: "Viernes",
    icon: "🥋",
    trains: ["bjj"],
    exercises: ["Drills con gi", "Rolling en vivo", "Cadenas de sumisión"],
  },
  {
    day: "Sábado",
    icon: "🥋",
    trains: ["bjj", "running"],
    exercises: ["Open mat", "Drills técnicos", "Carrera suave de soltura"],
  },
  {
    day: "Domingo",
    icon: "😴",
    trains: [],
    exercises: ["Día de descanso", "Recuperación con sueño", "Caminata ligera"],
  },
];

// ── Everything below is derived from weeklySchedule ──────────────────
const dayCount = (key) => weeklySchedule.filter((d) => d.trains.includes(key)).length;

// Priority = whatever gets the most days on the mat/road/rack this week.
const priority = Object.keys(disciplines)
  .map((key) => ({ key, ...disciplines[key], days: dayCount(key) }))
  .sort((a, b) => b.days - a.days);

const priorityLabel = priority.map((d) => d.label).join(" > ");

const trainingDays = weeklySchedule.filter((d) => d.trains.length > 0);
const workoutsPerWeek = trainingDays.length;
const restDays = weeklySchedule.length - workoutsPerWeek;

// A day takes its colour from the highest-priority discipline it trains.
const leadDiscipline = (day) => priority.find((d) => day.trains.includes(d.key));
const focusLabel = (day) =>
  day.trains.length === 0
    ? "Descanso"
    : day.trains
        .slice()
        .sort((a, b) => priority.findIndex((p) => p.key === a) - priority.findIndex((p) => p.key === b))
        .map((k) => disciplines[k].label)
        .join(" + ");

const pageTitle = "Semana de entrenamiento";
const pageDescription = `Una semana típica de entrenamiento: BJJ, correr y pesas de cuerpo completo (sin piernas). Mi enfoque priorizado del fitness: ${priorityLabel}.`;

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Semana de entrenamiento de Toby",
  "description": `Un programa de entrenamiento semanal que combina jiu-jitsu brasileño, correr y pesas de cuerpo completo, priorizado ${priorityLabel}.`,
  "provider": {
    "@type": "Person",
    "name": "Toby"
  },
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "https://schema.org/OfflineMode",
    "courseWorkload": `P${workoutsPerWeek}D`
  }
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={courseSchema}>
  <main class="max-w-5xl mx-auto px-4 py-12">
    {/* Hero Section */}
    <section class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Semana de entrenamiento</h1>
      <p class="text-lg text-neutral-400 max-w-2xl mx-auto">
        Una semana típica equilibrando mis tres pilares: BJJ, correr y pesas de cuerpo completo (sin piernas).
        Todo está priorizado: <span class="text-blue-400 font-semibold">{priorityLabel}</span>
      </p>
    </section>

    {/* Stats Overview */}
    <section class="mb-12">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 text-center">
          <div class="text-3xl font-bold text-green-400 mb-1">{workoutsPerWeek}</div>
          <div class="text-sm text-neutral-400">Entrenamientos/semana</div>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 text-center">
          <div class="text-3xl font-bold text-white mb-1">{restDays}</div>
          <div class="text-sm text-neutral-400">Días de descanso</div>
        </div>
        {priority.map((d) => (
          <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 text-center">
            <div class={`text-3xl font-bold mb-1 ${d.stat}`}>{d.days}</div>
            <div class="text-sm text-neutral-400">{d.daysLabel}</div>
          </div>
        ))}
      </div>
    </section>

    {/* Weekly Schedule Grid */}
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
        <span>📅</span> Horario semanal
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {weeklySchedule.map((day) => {
          const lead = leadDiscipline(day);
          return (
            <div class={`bg-neutral-900 border rounded-xl p-5 transition-all hover:scale-[1.02] ${
              lead ? lead.card : 'border-neutral-800 opacity-70'
            }`}>
              <div class="flex items-center gap-2 mb-3 min-w-0">
                <span class="text-2xl shrink-0">{day.icon}</span>
                <h3 class="text-lg font-bold text-white truncate">{day.day}</h3>
              </div>
              <div class={`text-sm font-semibold mb-3 ${lead ? lead.focus : 'text-neutral-500'}`}>
                {focusLabel(day)}
              </div>
              <ul class="space-y-1">
                {day.exercises.map((ex) => (
                  <li class="text-sm text-neutral-400 flex items-start gap-2">
                    <span class="text-neutral-600 mt-1 shrink-0">•</span>
                    <span class="min-w-0">{ex}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </section>

    {/* Training Philosophy */}
    <section class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-white mb-4 flex items-center gap-2">
        <span>🧠</span> Filosofía de entrenamiento
      </h2>
      <div class="space-y-4">
        <p class="text-neutral-300 text-lg">
          Mi entrenamiento está organizado por prioridad: <span class="text-blue-400 font-bold">{priorityLabel}</span>
        </p>
        <div class="grid md:grid-cols-3 gap-6 mt-6">
          {priority.map((d, i) => (
            <div class={`bg-neutral-950 rounded-xl p-5 border ${d.panel}`}>
              <div class="text-3xl mb-2">{i === 0 ? '🏆' : d.icon}</div>
              <h3 class={`font-bold mb-2 ${d.focus}`}>#{i + 1} {d.label}</h3>
              <p class="text-neutral-400 text-sm">
                {d.blurb} {`${d.days} ${d.days === 1 ? 'día' : 'días'} por semana.`}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
