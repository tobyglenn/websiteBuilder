---
import Layout from '../../layouts/Layout.astro';
import { projectGroups as publicProjectGroups, projectHref } from '../../data/projects';

const projectGroups = [
  {
    eyebrow: "Automatización",
    title: "Automatización de Pokémon GO",
    description: "Flujos de Python para dispositivos conectados, con la configuración personal fuera del código público.",
    projects: [{ ...publicProjectGroups[0].projects[0], title: "Automatización de Pokémon GO", description: "Regalos, solicitudes de amistad, GO Battle League, intercambios, transferencias y bayas en un kit documentado para Android e iOS.", status: "Código abierto" }],
  },
  {
    eyebrow: 'Juegos',
    title: 'Experimentos jugables',
    description: 'Juegos de navegador y prototipos tácticos lo suficientemente listos para jugar.',
    projects: [
      {
        slug: 'mma-rpg',
        title: 'MMA RPG',
        status: 'En vivo',
        description: 'Un RPG de lucha de MMA por turnos. Crea tu luchador, domina los combos y sube en los rangos.',
        href: 'https://clawdassistant85-netizen.github.io/mma-rpg/',
        cta: 'Jugar ahora',
        tags: ['Lucha', 'RPG', 'Estrategia'],
      },
      {
        slug: 'gridbound-realms',
        title: 'Gridbound Realms',
        status: 'En vivo',
        description: 'Un juego de estrategia táctica por cuadrícula. Manda unidades, controla el mapa y conquista el reino.',
        href: 'https://clawdassistant85-netizen.github.io/gridbound-realms/',
        cta: 'Jugar ahora',
        tags: ['Estrategia', 'Táctica', 'Cuadrícula'],
      },
    ],
  },
  {
    eyebrow: 'Aplicaciones',
    title: 'Herramientas de entrenamiento y nutrición',
    description: 'Utilidades de fitness creadas en torno a los flujos de trabajo que realmente uso para el tiempo en el tatami, las comidas y el seguimiento del progreso.',
    projects: [
      {
        slug: 'bjj-buddy',
        title: 'BJJ Buddy',
        status: 'En vivo',
        description: 'Una aplicación de seguimiento de Brazilian Jiu-Jitsu para registrar rolls, organizar técnicas, guardar favoritas y acompañar el progreso de grappling a lo largo del tiempo.',
        href: 'https://bjj-buddy.pages.dev/',
        cta: 'Abrir app',
        tags: ['BJJ', 'Registro de entrenamiento', 'Técnicas'],
      },
      {
        slug: 'nutritrack',
        title: 'NutriTrack',
        status: 'En vivo',
        description: 'Un rastreador de nutrición gratuito para registrar comidas, controlar macros y mantener los datos de alimentos conectados con los objetivos de entrenamiento.',
        href: 'https://nutritrack.tobyonfitnesstech.com',
        cta: 'Abrir rastreador',
        tags: ['Nutrición', 'Macros', 'Registro de comidas'],
      },
    ],
  },
  {
    eyebrow: 'Iglesia',
    title: 'Práctica de Escritura y memoria',
    description: 'Herramientas centradas en la fe, creadas para la práctica, la repetición y la retención a largo plazo.',
    projects: [
      {
        slug: 'one-peter-memory',
        title: 'Entrenador de memoria de 1 Pedro',
        status: 'En progreso',
        description: 'Un entrenador de memorización de la KJV para la preparación de Alert Academy con fragmentos, voces de audio, texto que desaparece, puntuación de recitación y repaso espaciado.',
        href: '/es/one-peter-memory/',
        cta: 'Abrir entrenador',
        tags: ['Escritura', 'Memorización', 'KJV'],
      },
    ],
  },
  {
    eyebrow: 'Vídeo',
    title: 'Canales de vídeo y trabajo creativo',
    description: 'Vídeos de juegos, trabajo creativo familiar y series de historias con ayuda de IA, donde cada canal mantiene su propia voz.',
    projects: [
      {
        slug: 'lilly',
        title: 'Lilly Plays',
        status: 'Activo',
        description: 'Vídeos de juegos y creativos con Lilly, incluidos Minecraft, Roblox, AEW y aventuras familiares. Lilly lidera los vídeos; yo ayudo con la edición, los subtítulos y la publicación de episodios completos y Shorts.',
        href: 'https://www.youtube.com/channel/UC7ZfdS-b0zU-cE8Ie6NZVlQ',
        cta: 'Ver el canal de Lilly',
        tags: ['YouTube', 'Videojuegos', 'Aventuras familiares'],
      },
      {
        slug: 'ironvane',
        title: 'IronVane',
        status: 'Activo',
        description: 'El canal de historias de Crossfire/IronVane, centrado actualmente en Ceryn, Talya y la temporada de episodios en curso.',
        href: 'https://www.youtube.com/@IronVaneStory/videos',
        cta: 'Ver la serie',
        tags: ['YouTube', 'Historia', 'Vídeo con IA'],
      },
      {
        slug: 'liminal',
        title: 'Liminal',
        status: 'Archivado',
        description: 'Una serie de comedia sobrenatural ambientada en una posada junto al mar. La producción está en pausa, pero los episodios publicados siguen disponibles en YouTube.',
        href: 'https://www.youtube.com/watch?v=Vo_LQS1ubWc',
        cta: 'Ver Liminal',
        tags: ['YouTube', 'Comedia', 'Archivado'],
      },
    ],
  },
];

const allProjects = projectGroups.flatMap((group) => group.projects.map((project) => ({
  ...project,
  group: group.eyebrow,
})));

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Proyectos | Toby on Fitness Tech',
  description: 'Juegos, herramientas de entrenamiento, práctica de Escritura y canales de vídeo de Toby on Fitness Tech.',
  url: 'https://tobyonfitnesstech.com/es/projects/',
  hasPart: allProjects.map((project) => ({
    '@type': 'CreativeWork',
    name: project.title,
    url: `https://tobyonfitnesstech.com${projectHref(project.slug)}`,
    about: project.group,
  })),
};
---

<Layout
  title="Proyectos | Toby on Fitness Tech"
  description="Juegos, herramientas de entrenamiento, práctica de Escritura y canales de vídeo de Toby on Fitness Tech."
  jsonLd={projectSchema}
  breadcrumbs={[{ name: 'Inicio', url: '/es/' }, { name: 'Proyectos', url: '/es/projects/' }]}

  lang="es"
  translationBase="/projects/"
>
  <main class="min-h-screen bg-neutral-950 px-4 py-16 text-white sm:px-6">
    <div class="mx-auto max-w-6xl">
      <header class="border-b border-neutral-800 pb-10">
        <p class="text-sm font-bold uppercase tracking-widest text-blue-400">Proyectos</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Juegos, herramientas y canales creativos</h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-neutral-400">
          Explora las cosas que construyo y ayudo a dar vida: juegos jugables, aplicaciones de entrenamiento y nutrición, práctica de Escritura, los vídeos de juegos de Lilly y el trabajo de historias de IronVane/Liminal.
        </p>
      </header>

      <nav class="flex flex-wrap gap-3 border-b border-neutral-800 py-5" aria-label="Categorías de proyectos">
        {projectGroups.map((group) => (
          <a
            href={`#${group.eyebrow.toLowerCase()}`}
            class="rounded-md border border-neutral-800 px-4 py-2 text-sm font-semibold text-neutral-300 transition-colors hover:border-blue-500/60 hover:text-white"
            data-analytics-event="project_category_click"
            data-analytics-content-type="project_category"
            data-analytics-content-slug={group.eyebrow.toLowerCase()}
            data-analytics-content-title={group.title}
          >
            {group.eyebrow}
          </a>
        ))}
      </nav>

      <div class="space-y-14 py-10">
        {projectGroups.map((group) => (
          <section id={group.eyebrow.toLowerCase()} aria-labelledby={`${group.eyebrow.toLowerCase()}-heading`}>
            <div class="mb-6 max-w-3xl">
              <p class="text-xs font-bold uppercase tracking-widest text-neutral-500">{group.eyebrow}</p>
              <h2 id={`${group.eyebrow.toLowerCase()}-heading`} class="mt-2 text-2xl font-bold text-white">{group.title}</h2>
              <p class="mt-2 text-neutral-400">{group.description}</p>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              {group.projects.map((project) => (
                <article
                  id={project.slug}
                  class="flex min-h-full flex-col rounded-lg border border-neutral-800 bg-neutral-900 p-6 transition-colors hover:border-blue-500/50"
                  data-project-card={project.slug}
                  data-analytics-content-title={project.title}
                  data-analytics-position={group.eyebrow.toLowerCase()}
                >
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-2xl font-bold text-white"><a href={projectHref(project.slug)} class="hover:text-blue-300">{project.title}</a></h3>
                    <span class="shrink-0 rounded-md border border-neutral-700 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-300">
                      {project.status}
                    </span>
                  </div>
                  <p class="mt-4 flex-1 leading-relaxed text-neutral-300">{project.description}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="rounded-md bg-neutral-800 px-2.5 py-1 text-xs font-semibold text-neutral-300">{tag}</span>
                    ))}
                  </div>
                  <a
                    href={projectHref(project.slug)}
                    class="mt-6 inline-flex w-fit items-center gap-2 rounded-md bg-blue-600 px-4 py-2.5 font-semibold text-white transition-colors hover:bg-blue-500"
                    data-analytics-event="project_card_click"
                    data-analytics-content-type="project"
                    data-analytics-content-slug={project.slug}
                    data-analytics-content-title={project.title}
                    data-analytics-position={group.eyebrow.toLowerCase()}
                  >
                    Explorar proyecto (inglés) <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>