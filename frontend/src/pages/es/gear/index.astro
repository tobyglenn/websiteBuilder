---
import Layout from '../../../layouts/Layout.astro';
import { currentGearItems, replacedGearItems } from '../../../data/gearItems';
import siteMetrics from '../../../data/siteMetrics.json';
import { garminStats, formatMetric, whoopWindowDescription, eightSleepWindowDescription } from '../../../data/fitnessStats';

const speedianceStats = { totalVolume: siteMetrics.strength.totalVolumeLbs, totalWorkouts: siteMetrics.strength.totalWorkouts };
const avgRecovery = siteMetrics.whoop.recoveryAvg, avgHRV = siteMetrics.whoop.hrvAvg, avgRHR = siteMetrics.whoop.rhrAvg;
const avgSleepScore = siteMetrics.eightSleep.avgScore, avgSleepHours = siteMetrics.eightSleep.avgHours;

const gearJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Equipo de tecnología fitness de Toby",
  description: 'Lista compacta de equipo con enlaces directos a reseñas completas y detalladas.',
  url: 'https://tobyonfitnesstech.com/es/gear',
  itemListElement: currentGearItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    description: item.shortDescription,
    image: `https://tobyonfitnesstech.com${item.image}`,
    url: `https://tobyonfitnesstech.com/gear/${item.slug}/`
  }))
};

const verdictClasses: Record<string, string> = {
  'Not Recommended': 'bg-red-500/15 text-red-300 border-red-500/25',
  Good: 'bg-yellow-500/15 text-yellow-300 border-yellow-500/25',
  Great: 'bg-blue-500/15 text-blue-300 border-blue-500/25',
  Essential: 'bg-green-500/15 text-green-300 border-green-500/25'
};
---

<Layout title="Mi equipo - Toby on Fitness Tech" description="Lista rápida del equipo de tecnología fitness que uso, con resúmenes cortos y enlaces a reseñas detalladas." jsonLd={gearJsonLd}>
  <main class="min-h-screen bg-neutral-950 text-white">
    <section data-page-intro class="pt-6 pb-6 md:pt-8 md:pb-8 border-b border-neutral-900/80">
      <div class="container mx-auto px-4 max-w-5xl">
        <p class="text-xs font-bold tracking-widest text-blue-400 uppercase mb-4">Lista de equipo</p>
        <h1 data-page-title class="text-4xl md:text-5xl font-bold leading-tight mb-5">Lo que uso (lista rápida)</h1>
        <p class="text-lg text-neutral-400 max-w-3xl">
          Esta página ahora es un índice rápido. Cada artículo tiene aquí un resumen corto y una imagen, y luego enlaza a su propia página de reseña completa con notas detalladas, pros, contras y contexto.
        </p>
      </div>
    </section>

    <section class="py-12 md:py-16 border-b border-neutral-900/80">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-xs font-bold tracking-widest text-cyan-400 uppercase mb-2">Estadísticas en vivo</p>
            <h2 class="text-2xl md:text-3xl font-bold">Datos de rendimiento del mundo real</h2>
          </div>
          <p class="text-xs text-neutral-500 hidden md:block">Calculado automáticamente a partir de los conjuntos de datos actuales</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/60 hover:border-cyan-500/40 hover:bg-neutral-900 transition-all p-6 md:p-8">
            <div class="flex items-start justify-between mb-4">
              <div class="text-4xl">🏋️</div>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/25">Fuerza</span>
            </div>
            <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-cyan-300 transition-colors">Speediance Gym Monster 2S</h3>
            <p class="text-sm text-neutral-400 mb-6">Gimnasio inteligente para casa impulsado por IA con resistencia electrónica.</p>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-neutral-950 rounded-lg p-4 border border-neutral-800">
                <div class="text-2xl md:text-3xl font-bold text-cyan-400">{new Intl.NumberFormat('es-ES').format(speedianceStats.totalVolume)}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Lbs totales levantadas</div>
              </div>
              <div class="bg-neutral-950 rounded-lg p-4 border border-neutral-800">
                <div class="text-2xl md:text-3xl font-bold text-cyan-400">{speedianceStats.totalWorkouts}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Entrenamientos</div>
              </div>
            </div>
          </div>

          <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/60 hover:border-cyan-500/40 hover:bg-neutral-900 transition-all p-6 md:p-8">
            <div class="flex items-start justify-between mb-4">
              <div class="text-4xl">⌚</div>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/25">Multideporte</span>
            </div>
            <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-cyan-300 transition-colors">Garmin Forerunner 265S</h3>
            <p class="text-sm text-neutral-400 mb-6">Reloj GPS multideporte premium para correr y entrenar.</p>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-neutral-950 rounded-lg p-4 border border-neutral-800">
                <div class="text-2xl md:text-3xl font-bold text-cyan-400">{garminStats.totalMiles}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Millas totales</div>
              </div>
              <div class="bg-neutral-950 rounded-lg p-4 border border-neutral-800">
                <div class="text-2xl md:text-3xl font-bold text-cyan-400">{garminStats.totalRuns}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Carreras</div>
              </div>
            </div>
          </div>

          <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/60 hover:border-cyan-500/40 hover:bg-neutral-900 transition-all p-6 md:p-8">
            <div class="flex items-start justify-between mb-4">
              <div class="text-4xl">💓</div>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/25">Recuperación</span>
            </div>
            <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-cyan-300 transition-colors">WHOOP 5.0</h3>
            <p class="text-sm text-neutral-400 mb-6">Monitorización continua de salud con seguimiento de recuperación.</p>
            <div class="grid grid-cols-3 gap-3">
              <div class="bg-neutral-950 rounded-lg p-3 border border-neutral-800">
                <div class="text-xl md:text-2xl font-bold text-cyan-400">{formatMetric(avgRecovery, 0)}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Recuperación prom.</div>
              </div>
              <div class="bg-neutral-950 rounded-lg p-3 border border-neutral-800">
                <div class="text-xl md:text-2xl font-bold text-cyan-400">{formatMetric(avgHRV, 1)}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">HRV (ms)</div>
              </div>
              <div class="bg-neutral-950 rounded-lg p-3 border border-neutral-800">
                <div class="text-xl md:text-2xl font-bold text-cyan-400">{formatMetric(avgRHR, 0)}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">RHR (bpm)</div>
              </div>
            </div>
            <p class="text-xs text-neutral-500 mt-3">WHOOP: {whoopWindowDescription}</p>
          </div>

          <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/60 hover:border-cyan-500/40 hover:bg-neutral-900 transition-all p-6 md:p-8">
            <div class="flex items-start justify-between mb-4">
              <div class="text-4xl">😴</div>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/25">Sueño</span>
            </div>
            <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-cyan-300 transition-colors">8Sleep Pod 4</h3>
            <p class="text-sm text-neutral-400 mb-6">Colchón inteligente con control de temperatura y seguimiento del sueño.</p>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-neutral-950 rounded-lg p-4 border border-neutral-800">
                <div class="text-2xl md:text-3xl font-bold text-cyan-400">{formatMetric(avgSleepScore)}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Puntaje prom. de sueño</div>
              </div>
              <div class="bg-neutral-950 rounded-lg p-4 border border-neutral-800">
                <div class="text-2xl md:text-3xl font-bold text-cyan-400">{formatMetric(avgSleepHours, 1)}</div>
                <div class="text-xs text-neutral-500 uppercase tracking-wide mt-1">Horas prom.</div>
              </div>
            </div>
            <p class="text-xs text-neutral-500 mt-3">8Sleep: {eightSleepWindowDescription}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-2xl font-bold mb-2">Equipo actual</h2>
        <p class="text-sm text-neutral-500 mb-8">Equipo de uso diario y herramientas activas en mi flujo de trabajo.</p>

        <div class="space-y-4">
          {currentGearItems.map((item) => (
            <a
              href={`/gear/${item.slug}/`}
              class="group block rounded-2xl border border-neutral-800 bg-neutral-900/60 hover:border-blue-500/40 hover:bg-neutral-900 transition-all"
            >
              <article class="p-4 md:p-5 grid gap-4 md:grid-cols-[180px_1fr_auto] md:items-center">
                <img
                  src={item.image}
                  alt={item.name}
                  class="w-full h-32 object-cover rounded-lg border border-neutral-800"
                  loading="lazy"
                />

                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="text-xs text-neutral-400">{item.categoryEmoji} {item.category}</span>
                    <span class={`text-xs px-2 py-0.5 rounded-full border ${verdictClasses[item.verdict]}`}>{item.verdict === 'Not Recommended' ? 'No recomendado' : item.verdict === 'Good' ? 'Bueno' : item.verdict === 'Great' ? 'Excelente' : 'Esencial'}</span>
                    <span class="text-xs text-neutral-500">{item.location}</span>
                  </div>
                  <h3 class="text-xl font-semibold group-hover:text-blue-300 transition-colors">{item.name}</h3>
                  <p class="text-sm text-neutral-400 mt-2">{item.shortDescription}</p>
                </div>

                <div class="text-sm font-semibold text-blue-300 group-hover:text-blue-200">Detalles completos →</div>
              </article>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 border-t border-neutral-900">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-2xl font-bold mb-2">Lo que reemplacé</h2>
        <p class="text-sm text-neutral-500 mb-8">Dispositivos anteriores y por qué dejaron de formar parte de mi stack.</p>

        <div class="grid gap-4 md:grid-cols-2">
          {replacedGearItems.map((item) => (
            <a
              href={`/gear/${item.slug}/`}
              class="group rounded-2xl border border-neutral-800 bg-neutral-900/50 hover:border-red-500/35 transition-colors p-4"
            >
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs text-neutral-400">{item.categoryEmoji} {item.category}</span>
                <span class={`text-xs px-2 py-0.5 rounded-full border ${verdictClasses[item.verdict]}`}>{item.verdict === 'Not Recommended' ? 'No recomendado' : item.verdict === 'Good' ? 'Bueno' : item.verdict === 'Great' ? 'Excelente' : 'Esencial'}</span>
              </div>
              <h3 class="font-semibold text-lg group-hover:text-red-300 transition-colors">{item.name}</h3>
              <p class="text-sm text-neutral-400 mt-2">{item.shortDescription}</p>
              <p class="text-xs text-neutral-500 mt-3">Ver contexto completo →</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
