---
import Layout from '../../layouts/Layout.astro';
import { LISTING_BLOG_POSTS } from '../../lib/blogPosts';
import { ArrowRight, BarChart3, HeartPulse, Moon, Scale, Watch } from 'lucide-react';

const wearablePosts = LISTING_BLOG_POSTS
  .filter((post) => /whoop|oura|garmin|wearable|recovery|sleep|hrv/i.test([
    post.title,
    post.excerpt,
    post.category,
    ...(post.tags || []),
  ].join(' ')))
  .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime());

const preferredSlugs = [
  'whoop-5-not-smaller-review',
  'oura-vs-whoop-sleep-comparison',
  'garmin-and-whoop-what-each-is-actually-for',
  'whoop-recovery-scores-explained',
];

const featuredPosts = preferredSlugs
  .map((slug) => wearablePosts.find((post) => post.slug === slug))
  .filter((post): post is (typeof wearablePosts)[number] => Boolean(post));

for (const post of wearablePosts) {
  if (featuredPosts.length >= 4) break;
  if (!featuredPosts.some((featured) => featured?.slug === post.slug)) featuredPosts.push(post);
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Reseñas de Wearables y Datos de Recuperación',
  description: 'Comparaciones prácticas de WHOOP, Oura, Garmin, sueño y recuperación respaldadas por datos reales de entrenamiento de Toby Peters.',
  url: 'https://tobyonfitnesstech.com/es/wearables/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: featuredPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://tobyonfitnesstech.com/blog/${post.slug}/`,
      name: post.title,
    })),
  },
};
---

<Layout
  title="Reseñas de Wearables: WHOOP, Oura y Garmin Comparados"
  description="Comparaciones prácticas de WHOOP, Oura y Garmin con datos en vivo de recuperación, HRV, sueño y entrenamiento de un atleta que usa los dispositivos juntos."
  image="/images/gear/whoop-5.0.jpg"
  jsonLd={articleSchema}
  breadcrumbs={[{ name: 'Inicio', url: '/es/' }, { name: 'Wearables', url: '/es/wearables/' }]}

  lang="es"
  translationBase="/wearables/"
>
  <section class="relative flex min-h-[460px] items-end overflow-hidden border-b border-neutral-800">
    <img
      src="/images/gear/whoop-5.0.jpg"
      alt="Wearable WHOOP usado para el seguimiento de recuperación de Toby"
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/55 to-transparent"></div>
    <div class="container relative z-10 mx-auto px-4 pb-14 pt-32">
      <div class="max-w-3xl">
        <div class="mb-4 flex items-center gap-2 text-sm font-semibold text-cyan-300">
          <Watch size={18} />
          Pruebas independientes de wearables
        </div>
        <h1 class="mb-5 text-4xl font-bold leading-tight text-white md:text-6xl">
          Reseñas de Wearables y Datos de Recuperación
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-neutral-200 md:text-xl">
          WHOOP, Oura y Garmin probados en la misma vida de entrenamiento. Las comparaciones aquí conectan las afirmaciones del producto con datos de sueño, HRV, carrera, pesas y BJJ.
        </p>
      </div>
    </div>
  </section>

  <div class="bg-neutral-950">
    <section class="border-b border-neutral-900 py-12">
      <div class="container mx-auto px-4">
        <div class="mb-7 max-w-2xl">
          <p class="mb-2 text-xs font-semibold uppercase text-cyan-400">Empieza con la decisión</p>
          <h2 class="text-2xl font-bold text-white md:text-3xl">¿Qué es lo que realmente intentas medir?</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <a href="/es/wearables/whoop-5-vs-4-vs-oura/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-cyan-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="whoop-comparison" data-analytics-content-title="WHOOP 5 vs 4 vs Oura">
            <Moon size={22} class="mb-5 text-cyan-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-cyan-300">WHOOP 5 vs 4 vs Oura</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Grosor, batería, correas, sueño, recuperación y el papel que juega Garmin junto a ellos.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-400">Abrir la comparación <ArrowRight size={15} /></span>
          </a>
          <a href="/es/blog/garmin-and-whoop-what-each-is-actually-for/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-green-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="training-comparison" data-analytics-content-title="training and running">
            <HeartPulse size={22} class="mb-5 text-green-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-green-300">Entrenamiento y carrera</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Garmin para el entrenamiento en sí, WHOOP para la respuesta de recuperación a su alrededor.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-green-400">Comparar roles de entrenamiento <ArrowRight size={15} /></span>
          </a>
          <a href="/es/compare-trackers/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-amber-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="tracker-guide" data-analytics-content-title="choose a tracker">
            <Scale size={22} class="mb-5 text-amber-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-amber-300">Elige un dispositivo</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Usa la guía de trackers cuando el presupuesto, las suscripciones y los objetivos de entrenamiento importan juntos.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400">Abrir guía de trackers <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-neutral-900 py-14">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="mb-2 text-xs font-semibold uppercase text-blue-400">Guías del lector</p>
            <h2 class="text-2xl font-bold text-white md:text-3xl">Comparaciones de wearables y notas de campo</h2>
          </div>
          <a href="/es/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300">Todos los artículos <ArrowRight size={15} /></a>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {featuredPosts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="group overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 hover:border-blue-500/60"
              data-analytics-event="content_card_click"
              data-analytics-content-type="blog"
              data-analytics-content-slug={post.slug}
              data-analytics-content-title={post.title}
            >
              <div class="aspect-video overflow-hidden bg-neutral-800">
                {post.image && <img src={post.image} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />}
              </div>
              <div class="p-5">
                <p class="mb-2 text-xs font-semibold text-blue-400">{post.category}</p>
                <h3 class="mb-3 line-clamp-3 text-sm font-semibold leading-snug text-white group-hover:text-blue-300">{post.title}</h3>
                <p class="line-clamp-3 text-xs leading-relaxed text-neutral-500">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14">
      <div class="container mx-auto grid gap-10 px-4 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase text-emerald-400">Los números detrás de las reseñas</p>
          <h2 class="mb-4 text-3xl font-bold text-white">Mira los datos de recuperación, no solo la opinión del producto</h2>
          <p class="max-w-xl leading-relaxed text-neutral-400">
            Las páginas en vivo muestran las mismas señales de recuperación, sueño y entrenamiento que se comentan en las reseñas. Esto permite ver cómo se comportan los dispositivos a lo largo de semanas reales en lugar de una sola prueba controlada.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/es/whoop/" class="rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-emerald-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="/es/whoop/" data-analytics-content-title="live WHOOP data">
            <HeartPulse size={22} class="mb-4 text-emerald-400" />
            <h3 class="mb-2 font-semibold text-white">Recuperación WHOOP en vivo</h3>
            <p class="mb-4 text-sm text-neutral-400">HRV, frecuencia cardíaca en reposo, rendimiento del sueño y tendencias de recuperación.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400">Ver datos de recuperación <ArrowRight size={15} /></span>
          </a>
          <a href="/es/sleep/" class="rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-violet-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="/es/sleep/" data-analytics-content-title="sleep data">
            <BarChart3 size={22} class="mb-4 text-violet-400" />
            <h3 class="mb-2 font-semibold text-white">Datos de sueño</h3>
            <p class="mb-4 text-sm text-neutral-400">Patrones nocturnos y el contexto de recuperación alrededor de la carga de entrenamiento.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-violet-400">Ver tendencias de sueño <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>