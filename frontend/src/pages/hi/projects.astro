---
import Layout from '../../layouts/Layout.astro';

import { projectGroups, projectHref } from '../../data/projects';

const allProjects = projectGroups.flatMap((group) => group.projects.map((project) => ({
  ...project,
  group: group.eyebrow,
})));

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'प्रोजेक्ट्स | Toby on Fitness Tech',
  description: 'Pokémon GO ऑटोमेशन, गेम्स, ट्रेनिंग टूल्स, धर्मग्रंथ अभ्यास, और विस्तृत गाइड्स के साथ रचनात्मक वीडियो प्रोजेक्ट्स।',
  url: 'https://tobyonfitnesstech.com/hi/projects/',
  hasPart: allProjects.map((project) => ({
    '@type': 'CreativeWork',
    name: project.title,
    url: `https://tobyonfitnesstech.com${projectHref(project.slug)}`,
    about: project.group,
  })),
};
---

<Layout
  title="प्रोजेक्ट्स | Toby on Fitness Tech"
  description="Pokémon GO ऑटोमेशन, गेम्स, ट्रेनिंग टूल्स, धर्मग्रंथ अभ्यास, और विस्तृत गाइड्स के साथ रचनात्मक वीडियो प्रोजेक्ट्स।"
  jsonLd={projectSchema}
  breadcrumbs={[{ name: 'होम', url: '/hi/' }, { name: 'प्रोजेक्ट्स', url: '/hi/projects/' }]}

  lang="hi"
  translationBase="/projects/"
>
  <main class="min-h-screen bg-neutral-950 px-4 py-16 text-white sm:px-6">
    <div class="mx-auto max-w-6xl">
      <header class="border-b border-neutral-800 pb-10">
        <p class="text-sm font-bold uppercase tracking-widest text-blue-400">प्रोजेक्ट्स</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">ऑटोमेशन, गेम्स, और रचनात्मक प्रोजेक्ट्स</h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-neutral-400">
          उन चीज़ों को देखें जिन्हें मैं बनाता हूँ और जीवन में लाने में मदद करता हूँ। किसी प्रोजेक्ट की कहानी, वर्कफ़्लो, डॉक्यूमेंटेशन और लिंक्स के लिए उसे खोलें—जिसमें Pokémon GO ऑटोमेशन टूलकिट और Lilly के वीडियो शामिल हैं।
        </p>
      </header>

      <nav class="flex flex-wrap gap-3 border-b border-neutral-800 py-5" aria-label="प्रोजेक्ट श्रेणियाँ">
        {projectGroups.map((group) => (
          <a
            href={`#${group.id}`}
            class="rounded-md border border-neutral-800 px-4 py-2 text-sm font-semibold text-neutral-300 transition-colors hover:border-blue-500/60 hover:text-white"
            data-analytics-event="project_category_click"
            data-analytics-content-type="project_category"
            data-analytics-content-slug={group.id}
            data-analytics-content-title={group.title}
          >
            {group.eyebrow}
          </a>
        ))}
      </nav>

      <div class="space-y-14 py-10">
        {projectGroups.map((group) => (
          <section id={group.id} aria-labelledby={`${group.id}-heading`}>
            <div class="mb-6 max-w-3xl">
              <p class="text-xs font-bold uppercase tracking-widest text-neutral-500">{group.eyebrow}</p>
              <h2 id={`${group.id}-heading`} class="mt-2 text-2xl font-bold text-white">{group.title}</h2>
              <p class="mt-2 text-neutral-400">{group.description}</p>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              {group.projects.map((project) => (
                <article
                  id={project.slug}
                  class="flex min-h-full flex-col rounded-lg border border-neutral-800 bg-neutral-900 p-6 transition-colors hover:border-blue-500/50"
                  data-project-card={project.slug}
                  data-analytics-content-title={project.title}
                  data-analytics-position={group.id}
                >
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-2xl font-bold text-white"><a href={projectHref(project.slug)} class="hover:text-blue-300">{project.title}</a></h3>
                    <span class="shrink-0 rounded-md border border-neutral-700 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-300">
                      {project.status}
                    </span>
                  </div>
                  <p class="mt-4 flex-1 leading-relaxed text-neutral-300">{project.description}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="rounded-md bg-neutral-800 px-2.5 py-1 text-xs font-semibold text-neutral-300">{tag}</span>
                    ))}
                  </div>
                  <a
                    href={projectHref(project.slug)}
                    class="mt-6 inline-flex w-fit items-center gap-2 rounded-md bg-blue-600 px-4 py-2.5 font-semibold text-white transition-colors hover:bg-blue-500"
                    data-analytics-event="project_card_click"
                    data-analytics-content-type="project"
                    data-analytics-content-slug={project.slug}
                    data-analytics-content-title={project.title}
                    data-analytics-position={group.id}
                  >
                    प्रोजेक्ट देखें <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>