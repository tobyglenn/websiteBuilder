---
import { usesWildRacingReviewImage } from '../../../lib/wildRacingBlogPresentation.mjs';
import { usesPokemonFeatureImage } from '../../../lib/pokemonBlogPresentation.mjs';
import Layout from '../../../layouts/Layout.astro';
import ShareButtons from '../../../components/ShareButtons.jsx';
import { marked } from 'marked';
import { ArrowLeft, ArrowRight, Calendar, Tag, User } from 'lucide-react';
import {
  BLOG_TRANSLATION_LOCALES,
  getLocalizedBlogPosts,
  type BlogTranslationLocale,
  type LocalizedBlogPost,
} from '../../../lib/localizedBlogPosts';
import { MANUAL_REDIRECTS } from '../../../lib/blogSlugRedirects';

const UI = {
  de: {
    back: 'Zurück zu den Analysen',
    minute: 'Min. Lesezeit',
    more: 'Weiter entdecken',
    all: 'Alle Analysen',
    speediance: 'Speediance-Analysen',
    whoop: 'WHOOP und Erholung',
    home: 'Startseite',
    blog: 'Analysen',
    dateLocale: 'de-DE',
  },
  es: {
    back: 'Volver a los análisis',
    minute: 'min de lectura',
    more: 'Seguir explorando',
    all: 'Todos los análisis',
    speediance: 'Análisis de Speediance',
    whoop: 'WHOOP y recuperación',
    home: 'Inicio',
    blog: 'Análisis',
    dateLocale: 'es-ES',
  },
  pt: {
    back: 'Voltar para as análises',
    minute: 'min de leitura',
    more: 'Continue explorando',
    all: 'Todas as análises',
    speediance: 'Análises da Speediance',
    whoop: 'WHOOP e recuperação',
    home: 'Início',
    blog: 'Análises',
    dateLocale: 'pt-BR',
  },
  hi: {
    back: 'विश्लेषण पर वापस जाएं',
    minute: 'मिनट में पढ़ें',
    more: 'आगे पढ़ें',
    all: 'सभी विश्लेषण',
    speediance: 'Speediance विश्लेषण',
    whoop: 'WHOOP और रिकवरी',
    home: 'होम',
    blog: 'विश्लेषण',
    dateLocale: 'hi-IN',
  },
} as const;

export function getStaticPaths() {
  return BLOG_TRANSLATION_LOCALES.flatMap((lang) => {
    const posts = getLocalizedBlogPosts(lang);
    const redirects = Object.entries(MANUAL_REDIRECTS).flatMap(([slug, target]) => {
      const destination = posts.find(post => post.slug === target);
      return destination ? [{ ...destination, slug }] : [];
    });
    return [...posts, ...redirects].map((post) => ({
      params: { lang, slug: post.slug },
      props: { lang, post },
    }));
  });
}

interface Props {
  lang: BlogTranslationLocale;
  post: LocalizedBlogPost;
}

const { lang, post } = Astro.props as Props;
const ui = UI[lang];
const wildRacingArtwork = {
  "de": {
    "alt": "Original-Vorschaubild der Folge mit Toby, dem Wild-Skies-Flugspiel und dem Schriftzug AI BUILT MY GAME.",
    "caption": "Original-Vorschaubild der Entwicklungsaufnahme vom 25. Oktober, einschließlich der Vorführung der Wild-Skies-Beta."
  },
  "es": {
    "alt": "Miniatura original del episodio con Toby, la pantalla de vuelo de Wild Skies y el texto AI BUILT MY GAME.",
    "caption": "Miniatura original de la grabación sobre el desarrollo del 25 de octubre, incluida la demostración de la beta de Wild Skies."
  },
  "pt": {
    "alt": "Miniatura original do episódio com Toby, a tela do jogo de voo Wild Skies e o texto AI BUILT MY GAME.",
    "caption": "Miniatura original da gravação sobre o desenvolvimento de 25 de outubro, incluindo a demonstração da versão beta de Wild Skies."
  },
  "hi": {
    "alt": "एपिसोड का मूल थंबनेल, जिसमें Toby, Wild Skies उड़ान गेम की स्क्रीन और AI BUILT MY GAME लिखा हुआ दिखाई देता है।",
    "caption": "25 अक्टूबर की विकास संबंधी रिकॉर्डिंग का मूल थंबनेल, जिसमें Wild Skies बीटा का प्रदर्शन भी शामिल है।"
  }
};
const museArtwork = {
  "de": {
    "alt": "Toby neben gezeichneten Rennfiguren im Vorschaubild des Livestreams Wild Racing und AI Update.",
    "caption": "Artwork für den gesamten Wild-Racing- und KI-Livestream vom 21. Oktober, in dem auch Muse besprochen wurde. Dies ist kein Screenshot der Muse-Oberfläche."
  },
  "es": {
    "alt": "Toby junto a personajes de carreras ilustrados en la miniatura del directo Wild Racing y AI Update.",
    "caption": "Imagen del directo completo sobre Wild Racing y novedades de IA del 21 de octubre, que incluyó la conversación sobre Muse. No es una captura de la interfaz de Muse."
  },
  "pt": {
    "alt": "Toby ao lado de personagens de corrida ilustrados na miniatura da transmissão Wild Racing e AI Update.",
    "caption": "Arte da transmissão completa de 21 de outubro sobre Wild Racing e novidades de IA, que incluiu a conversa sobre o Muse. Não é uma captura da interface do Muse."
  },
  "hi": {
    "alt": "Wild Racing और AI Update लाइवस्ट्रीम की थंबनेल में चित्रित रेसिंग पात्रों के साथ Toby।",
    "caption": "21 अक्टूबर की पूरी Wild Racing और एआई अपडेट लाइवस्ट्रीम की तस्वीर, जिसमें Muse पर चर्चा भी शामिल थी। यह Muse के इंटरफ़ेस का स्क्रीनशॉट नहीं है।"
  }
} as const;
const usesMuseArtwork = post.slug === "what-changed-my-mind-about-muse" && post.image === "/images/blog/what-changed-my-mind-about-muse-aria-review.jpg";

// Redirect pages for renamed slugs (mirrors the English blog template).
// The old slug stays out of the sitemap (see EXCLUDED_SITEMAP_PATHS in
// astro.config.mjs) and renders a redirect page whose canonical points
// at the new localized URL.
const redirectSlug = MANUAL_REDIRECTS[post.slug];
if (redirectSlug) {
  const redirectUrl = `/${lang}/blog/${redirectSlug}/`;
  const redirectDescription = (post.excerpt?.slice(0, 155) || post.title).replace(/"/g, '&quot;');
  const escapedTitle = post.title.replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return new Response(
    `<!DOCTYPE html><html lang="${lang}"><head>
<meta charset="UTF-8">
<title>${escapedTitle} - TobyOnFitnessTech</title>
<meta name="description" content="${redirectDescription}">
<link rel="canonical" href="https://tobyonfitnesstech.com${redirectUrl}">
<meta http-equiv="refresh" content="0;url=${redirectUrl}">
</head><body data-pagefind-ignore>
<h1>${escapedTitle}</h1>
<p>This page has moved. <a href="${redirectUrl}">Click here</a> if you are not redirected automatically.</p>
<script>window.location.replace("${redirectUrl}")<\/script>
</body></html>`,
    { status: 200, headers: { 'Content-Type': 'text/html; charset=utf-8' } }
  );
}
const articleHtml = await marked.parse(post.content || '');
const wordCount = post.content.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const postUrl = `https://tobyonfitnesstech.com/${lang}/blog/${post.slug}/`;
const imageUrl = post.image
  ? (post.image.startsWith('http') ? post.image : `https://tobyonfitnesstech.com${post.image}`)
  : undefined;
const publishedTimestamp = Date.parse(/^\d{4}-\d{2}-\d{2}$/.test(post.published_at)
  ? `${post.published_at}T12:00:00Z`
  : post.published_at);
const publishedLabel = Number.isNaN(publishedTimestamp)
  ? post.published_at
  : new Date(publishedTimestamp).toLocaleDateString(ui.dateLocale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  inLanguage: lang,
  datePublished: post.published_at,
  dateModified: post.translatedAt,
  url: postUrl,
  mainEntityOfPage: postUrl,
  ...(imageUrl ? { image: imageUrl } : {}),
  author: { '@id': 'https://tobyonfitnesstech.com/#toby' },
  publisher: { '@id': 'https://tobyonfitnesstech.com/#organization' },
};
---

<Layout
  title={`${post.title} - TobyOnFitnessTech`}
  description={post.excerpt}
  image={post.image}
  ogType="article"
  publishedTime={post.published_at}
  modifiedTime={post.translatedAt}
  author="Toby Glenn Peters"
  {lang}
  translationBase={`/blog/${post.slug}/`}
  jsonLd={blogSchema}
  breadcrumbs={[
    { name: ui.home, url: `/${lang}/` },
    { name: ui.blog, url: `/${lang}/blog/` },
    { name: post.title, url: `/${lang}/blog/${post.slug}/` },
  ]}
>
  <article class="min-h-screen bg-neutral-950 pb-24" data-pagefind-body>
    <header data-page-intro class="border-b border-neutral-800 bg-neutral-900 pb-6 pt-6 md:pt-8">
      <div class="container mx-auto max-w-4xl px-4">
        <a
          href={`/${lang}/blog/`}
          class="mb-8 inline-flex items-center text-sm font-semibold text-blue-400 transition-colors hover:text-blue-300"
        >
          <ArrowLeft size={16} class="mr-2" aria-hidden="true" />
          {ui.back}
        </a>

        <div class="mb-4 flex flex-wrap items-center gap-3 text-xs font-bold uppercase text-blue-400">
          <span class="rounded-full border border-blue-500/30 bg-blue-900/30 px-3 py-1">{post.category}</span>
          <span class="text-neutral-600" aria-hidden="true">/</span>
          <span>{readingMinutes} {ui.minute}</span>
        </div>

        <h1 data-page-title class="mb-6 max-w-4xl text-3xl font-bold leading-tight text-white md:text-5xl">{post.title}</h1>
        <p class="mb-8 max-w-3xl text-lg leading-relaxed text-neutral-300 md:text-xl">{post.excerpt}</p>

        <div class="flex flex-wrap items-center gap-6 border-t border-neutral-800 pt-6 text-sm text-neutral-400">
          <span class="inline-flex items-center gap-2 text-white"><User size={16} aria-hidden="true" /> Toby</span>
          <span class="inline-flex items-center gap-2"><Calendar size={16} aria-hidden="true" /> {publishedLabel}</span>
        </div>
        <ShareButtons url={postUrl} title={post.title} client:load />
      </div>
    </header>

    <div class="container mx-auto max-w-3xl px-4 py-12">
      {usesWildRacingReviewImage(post) && (
        <figure class="mb-8 overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900" data-reviewed-wild-racing-art>
          <img src={post.image} alt={wildRacingArtwork[lang].alt} width="1280" height="720" class="block h-auto w-full object-contain" loading="eager" />
          <figcaption class="px-4 py-3 text-sm leading-relaxed text-neutral-300">{wildRacingArtwork[lang].caption}</figcaption>
        </figure>
      )}
      {usesMuseArtwork && (
        <figure class="mb-8 overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900" data-reviewed-muse-art>
          <img src={post.image} alt={museArtwork[lang].alt} width="1280" height="720" class="block h-auto w-full object-contain" loading="eager" />
          <figcaption class="px-4 py-3 text-sm leading-relaxed text-neutral-300">{museArtwork[lang].caption}</figcaption>
        </figure>
      )}
      {usesPokemonFeatureImage(post) && (
        <figure class="mb-8 flex justify-center rounded-xl bg-neutral-900 p-4" data-reviewed-game-art>
          <img src={post.image} alt={post.title} width="1224" height="2992" class="h-auto max-h-[70vh] max-w-full object-contain" loading="eager" />
        </figure>
      )}
      <div class="markdown-shell rounded-lg border border-neutral-800 bg-neutral-900/55 px-6 py-8 md:px-10 md:py-10">
        <div class="markdown-article" set:html={articleHtml} />
      </div>

      {post.tags.length > 0 && (
        <div class="mt-12 flex flex-wrap items-center gap-2 border-t border-neutral-800 pt-8">
          <Tag size={16} class="mr-2 text-neutral-500" aria-hidden="true" />
          {post.tags.map((tag) => (
            <span class="rounded-full border border-neutral-800 bg-neutral-900 px-3 py-1 text-sm text-neutral-400">#{tag}</span>
          ))}
        </div>
      )}

      <nav class="mt-14 border-y border-neutral-800 py-9" aria-label={ui.more}>
        <h2 class="mb-5 text-xl font-bold text-white">{ui.more}</h2>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <a href={`/${lang}/blog/`} class="inline-flex items-center gap-2 font-semibold text-blue-400 hover:text-blue-300">
            {ui.all} <ArrowRight size={15} aria-hidden="true" />
          </a>
          <a href={`/${lang}/speediance/`} class="inline-flex items-center gap-2 font-semibold text-blue-400 hover:text-blue-300">
            {ui.speediance} <ArrowRight size={15} aria-hidden="true" />
          </a>
          <a href={`/${lang}/whoop/`} class="inline-flex items-center gap-2 font-semibold text-blue-400 hover:text-blue-300">
            {ui.whoop} <ArrowRight size={15} aria-hidden="true" />
          </a>
        </div>
      </nav>
    </div>
  </article>
</Layout>

<style is:global>
  .markdown-article {
    color: rgb(212 212 216);
    font-size: 1.075rem;
    line-height: 1.9;
  }
  .markdown-article > :first-child { margin-top: 0; }
  .markdown-article h1,
  .markdown-article h2,
  .markdown-article h3 {
    color: white;
    font-weight: 800;
    line-height: 1.25;
    margin: 2.5rem 0 1rem;
  }
  .markdown-article h1 { font-size: 2rem; }
  .markdown-article h2 { font-size: 1.65rem; }
  .markdown-article h3 { font-size: 1.3rem; }
  .markdown-article p,
  .markdown-article ul,
  .markdown-article ol,
  .markdown-article blockquote { margin: 1.25rem 0; }
  .markdown-article ul,
  .markdown-article ol { padding-left: 1.5rem; }
  .markdown-article ul { list-style: disc; }
  .markdown-article ol { list-style: decimal; }
  .markdown-article a { color: rgb(96 165 250); text-decoration: underline; }
  .markdown-article strong { color: white; }
  .markdown-article img { height: auto; max-width: 100%; border-radius: 0.5rem; }
  .markdown-article blockquote {
    border-left: 3px solid rgb(59 130 246);
    color: rgb(229 229 229);
    padding-left: 1rem;
  }
  .markdown-article pre {
    margin: 1.5rem 0;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid rgb(38 38 38);
    border-radius: 0.5rem;
    background: rgb(10 10 10);
    padding: 1rem;
  }
  .markdown-article code { overflow-wrap: anywhere; }
</style>
