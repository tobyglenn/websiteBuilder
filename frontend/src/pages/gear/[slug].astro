---
import Layout from '../../layouts/Layout.astro';
import { gearItems } from '../../data/gearItems';
import siteMetrics from '../../data/siteMetrics.json';
import { ExternalLink } from 'lucide-react';

export function getStaticPaths() {
  return gearItems.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;

const whoopLive = siteMetrics.whoop;

const verdictClasses: Record<string, string> = {
  'Not Recommended': 'bg-red-500/15 text-red-300 border-red-500/25',
  Good: 'bg-yellow-500/15 text-yellow-300 border-yellow-500/25',
  Great: 'bg-blue-500/15 text-blue-300 border-blue-500/25',
  Essential: 'bg-green-500/15 text-green-300 border-green-500/25'
};

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: item.name,
  category: item.category,
  description: item.shortDescription,
  image: `https://tobyonfitnesstech.com${item.image}`,
  url: `https://tobyonfitnesstech.com/gear/${item.slug}/`,
  review: {
    '@type': 'Review',
    author: {
      '@type': 'Person',
      name: 'Toby Peters'
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: item.verdict === 'Essential' ? 5 : item.verdict === 'Great' ? 4 : item.verdict === 'Good' ? 3 : 1,
      bestRating: 5
    },
    reviewBody: item.shortDescription,
    datePublished: new Date().toISOString()
  }
};
---

<Layout
  title={`${item.name} Review - Toby on Fitness Tech`}
  description={item.shortDescription}
  jsonLd={productJsonLd}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Gear', url: '/gear' },
    { name: item.name, url: `/gear/${item.slug}/` }
  ]}
>
  <main class="min-h-screen bg-neutral-950 text-white">
    <section data-page-intro class="pt-6 pb-6 border-b border-neutral-900/80">
      <div class="container mx-auto px-4 max-w-4xl">
        <a href="/gear/" class="inline-flex items-center text-sm text-blue-300 hover:text-blue-200 mb-6">← Back to gear list</a>

        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-xs text-neutral-400">{item.categoryEmoji} {item.category}</span>
          <span class={`text-xs px-2 py-0.5 rounded-full border ${verdictClasses[item.verdict]}`}>{item.verdict}</span>
          <span class="text-xs text-neutral-500">{item.location}</span>
        </div>

        <h1 data-page-title class="text-3xl md:text-4xl font-bold leading-tight mb-4">{item.name}</h1>
        <p class="text-lg text-neutral-400">{item.detailIntro}</p>
      </div>
    </section>

    <section class="py-10">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="mb-8 rounded-2xl border border-neutral-800 bg-neutral-900/70 p-4 md:p-6">
          <img
            src={item.image}
            alt={item.name}
            loading="eager"
            class="mx-auto w-full max-h-[560px] object-contain"
          />
        </div>

        <div class="space-y-4 mb-8">
          {item.details.map((paragraph: string) => (
            <p class="text-neutral-300 leading-relaxed">{paragraph}</p>
          ))}
        </div>

        {item.metrics && item.metrics.length > 0 && (
          <div class="grid gap-3 sm:grid-cols-2 mb-8">
            {item.metrics.map((metric: { label: string; value: string }) => (
              <div class="rounded-xl border border-neutral-800 bg-neutral-900/70 p-4">
                <div class="text-xl font-bold">{metric.value}</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">{metric.label}</div>
              </div>
            ))}
          </div>
        )}

        {item.slug === 'whoop-5' && whoopLive.available && (
          <div class="rounded-2xl border border-cyan-500/30 bg-cyan-950/20 p-6 md:p-8 mb-8">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-bold tracking-widest text-cyan-300 uppercase">Live Data</span>
              <span class="text-xs text-neutral-500">Auto-calculated from my WHOOP JSON at build time</span>
            </div>
            <h2 class="text-xl md:text-2xl font-bold mb-2 text-cyan-100">My Last 30 Days of WHOOP Data</h2>
            {whoopLive.windowEnd && (
              <p class="text-xs text-neutral-500 mb-6">
                Window: {whoopLive.windowStart?.slice(0, 10)} → {whoopLive.windowEnd.slice(0, 10)}
                {' · '}
                {whoopLive.totalRecords.toLocaleString()} recovery records on file
                {whoopLive.lastSynced && (
                  <span> · last WHOOP sync {whoopLive.lastSynced.slice(0, 10)}</span>
                )}
              </p>
            )}

            <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 mb-4">
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.recoveryAvg?.toFixed(0)}%</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg Recovery (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.hrvAvg?.toFixed(1)} ms</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg HRV (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.rhrAvg?.toFixed(0)} bpm</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg RHR (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.asleepHoursAvg?.toFixed(1)}h</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg Time Asleep (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.remHoursAvg?.toFixed(1)}h</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg REM (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.deepHoursAvg?.toFixed(1)}h</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg Deep (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.sleepPerfAvg?.toFixed(0)}%</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg Sleep Performance (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">
                  {whoopLive.strainAvg?.toFixed(1)}
                  {whoopLive.strainMax !== null && <span class="text-base text-neutral-500"> (peak {whoopLive.strainMax.toFixed(1)})</span>}
                </div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg Daily Strain (30d)</div>
              </div>
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-4">
                <div class="text-2xl font-bold text-cyan-300">{whoopLive.respiratoryAvg?.toFixed(1)}</div>
                <div class="text-xs text-neutral-500 mt-1 uppercase tracking-wide">Avg Respiratory Rate</div>
              </div>
            </div>

            {whoopLive.allTimeRecoveryAvg !== null && whoopLive.allTimeGreenPct !== null && (
              <div class="rounded-xl border border-cyan-500/20 bg-neutral-900/70 p-5">
                <h3 class="text-sm font-bold uppercase tracking-wide text-cyan-200 mb-3">All-time Recovery Distribution</h3>
                <div class="flex flex-wrap gap-3 text-sm">
                  <span class="text-green-300">● Green: {whoopLive.allTimeGreenPct.toFixed(1)}%</span>
                  <span class="text-yellow-300">● Yellow: {whoopLive.allTimeYellowPct?.toFixed(1)}%</span>
                  <span class="text-red-300">● Red: {whoopLive.allTimeRedPct?.toFixed(1)}%</span>
                  <span class="text-neutral-500">· avg recovery {whoopLive.allTimeRecoveryAvg.toFixed(0)}% across {whoopLive.totalRecords.toLocaleString()} days</span>
                </div>
              </div>
            )}

            <p class="text-xs text-neutral-500 mt-4">
              These numbers come from my actual WHOOP 5.0 device and are recomputed on every site rebuild.
              If the values look stale, run <code class="text-neutral-300 bg-neutral-800/60 px-1.5 py-0.5 rounded">npm run build</code> after the WHOOP sync finishes.
            </p>
          </div>
        )}

        <div class="grid gap-4 md:grid-cols-2 mb-8">
          <div class="rounded-xl border border-neutral-800 bg-neutral-900/70 p-5">
            <h2 class="text-sm font-bold uppercase tracking-wide text-green-300 mb-3">The Good</h2>
            <ul class="space-y-2 text-sm text-neutral-300">
              {item.pros.map((pro: string) => (
                <li>• {pro}</li>
              ))}
            </ul>
          </div>

          <div class="rounded-xl border border-neutral-800 bg-neutral-900/70 p-5">
            <h2 class="text-sm font-bold uppercase tracking-wide text-red-300 mb-3">Watchouts</h2>
            <ul class="space-y-2 text-sm text-neutral-300">
              {item.cons.map((con: string) => (
                <li>• {con}</li>
              ))}
            </ul>
          </div>
        </div>

        {item.replacedBy && (
          <div class="rounded-xl border border-neutral-800 bg-neutral-900/70 p-5 mb-8">
            <h2 class="text-sm font-bold uppercase tracking-wide text-neutral-300 mb-2">Replacement Context</h2>
            <p class="text-neutral-400 text-sm">{item.replacedBy}</p>
          </div>
        )}

        {item.externalUrl && item.externalLabel && (
          <a
            href={item.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-700 bg-neutral-900 text-neutral-200 hover:border-neutral-500 hover:text-white text-sm font-medium rounded-lg transition-colors"
          >
            {item.externalLabel}
            <ExternalLink size={15} aria-hidden="true" />
          </a>
        )}

        <p class="text-xs text-neutral-500 mt-4">{item.editorialNote}</p>
      </div>
    </section>
  </main>
</Layout>
