---
import Layout from '../../layouts/Layout.astro';
import { pokemonRepository, projectHref, projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const isPokemon = project.slug === 'pokemon-go-automation';
const sourceHref = (file: string) => `${pokemonRepository}/blob/main/${file}`;
const documentation = [
  { file: 'README.md', label: 'Start here', description: 'Installation, entry points, and the project overview.' },
  { file: 'docs/getting-started.md', label: 'First device', description: 'Prepare your environment and run the initial checks.' },
  { file: 'docs/configuration.md', label: 'Private configuration', description: 'Inventory, connection settings, and generic examples.' },
  { file: 'docs/workflows.md', label: 'Workflow guide', description: 'Options and operating steps for each command.' },
  { file: 'docs/architecture.md', label: 'Architecture', description: 'How commands, fleet routing, and device workers fit together.' },
  { file: 'docs/file-reference.md', label: 'File reference', description: 'Find the source file responsible for each part of the system.' },
  { file: 'docs/ai-handoff.md', label: 'AI handoff', description: 'Context and reproduction steps for another coding agent.' },
  { file: 'docs/testing.md', label: 'Verification', description: 'Separate code checks from live physical-device evidence.' },
  { file: 'docs/privacy.md', label: 'Privacy', description: 'Keep personal inventory and runtime data out of the public repository.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': isPokemon ? 'SoftwareSourceCode' : 'CreativeWork',
  name: project.title,
  description: project.description,
  url: `https://tobyonfitnesstech.com${projectHref(project.slug)}`,
  author: { '@type': 'Person', name: 'Toby Glenn Peters', url: 'https://tobyonfitnesstech.com/about/' },
  ...(isPokemon ? { codeRepository: pokemonRepository, programmingLanguage: 'Python' } : {}),
};
---

<Layout
  title={`${project.title} project guide | Toby on Fitness Tech`}
  description={project.description}
  jsonLd={schema}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Projects', url: '/projects/' }, { name: project.title, url: projectHref(project.slug) }]}
>
  <div class="project-page">
    <div class="project-shell">
      <a class="back-link" href="/projects/">← All Projects</a>

      <header class="project-hero">
        <div class="hero-copy">
          <div class="eyebrow"><span>{project.group}</span><span class="status">{project.status}</span></div>
          <h1>{project.title}</h1>
          <p class="summary">{project.description}</p>
          <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
          <div class="project-actions">
            {project.links.map((link, index) => (
              <a
                class:list={['action-link', { primary: index === 0 }]}
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                data-analytics-event="project_destination_click"
                data-analytics-content-type="project"
                data-analytics-content-slug={project.slug}
                data-analytics-content-title={project.title}
              >
                {link.label}<span aria-hidden="true">{link.href.startsWith('http') ? '↗' : '→'}</span>
              </a>
            ))}
          </div>
        </div>
        <nav class="page-nav" aria-label={`${project.title} page sections`}>
          <p>On this page</p>
          <a href="#overview">01 <span>What it is</span></a>
          <a href="#capabilities">02 <span>How it works</span></a>
          {project.workflowFiles && <a href="#workflow-files">03 <span>Files & commands</span></a>}
          <a href="#getting-started">{isPokemon ? '04' : '03'} <span>{isPokemon ? 'Recreate the setup' : 'Get started'}</span></a>
          {isPokemon && <a href="#documentation">05 <span>Documentation & AI handoff</span></a>}
          <a href="#project-notes">{isPokemon ? '06' : '04'} <span>Project notes</span></a>
        </nav>
      </header>

      <section id="overview" class="content-section overview" aria-labelledby="overview-heading">
        <div class="section-heading"><p class="section-label">The project</p><h2 id="overview-heading">What it is</h2></div>
        <div class="prose">{project.overview.map((paragraph) => <p>{paragraph}</p>)}</div>
      </section>

      <section id="capabilities" class="content-section" aria-labelledby="capabilities-heading">
        <div class="section-heading"><p class="section-label">Inside the project</p><h2 id="capabilities-heading">How it works</h2></div>
        <div class="feature-grid">
          {project.features.map((feature, index) => (
            <article class="feature">
              <span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </section>

      {project.workflowFiles && (
        <section id="workflow-files" class="content-section" aria-labelledby="files-heading">
          <div class="section-heading"><p class="section-label">The public entry points</p><h2 id="files-heading">One file for each workflow</h2></div>
          <p class="section-intro">Run these commands from the repository in your Python environment. The examples preview workflow routing; <code>fleet.py status</code> checks readiness. Each entry file links to the public source.</p>
          <div class="workflow-list">
            {project.workflowFiles.map((workflow) => (
              <article class="workflow" id={workflow.file.replace('.py', '')}>
                <div class="workflow-description">
                  <a class="file-link" href={sourceHref(workflow.file)} target="_blank" rel="noopener noreferrer"><code>{workflow.file}</code><span aria-hidden="true">↗</span></a>
                  <h3>{workflow.title}</h3>
                  <p>{workflow.description}</p>
                </div>
                <div class="workflow-source">
                  <p class="code-label">{workflow.file === 'fleet.py' ? 'Readiness check' : 'Preview the plan'}</p>
                  <pre><code>{workflow.command}</code></pre>
                  {workflow.implementation.length > 0 && (
                    <div class="implementation-links">
                      <p>Implementation</p>
                      {workflow.implementation.map((file) => <a href={sourceHref(file)} target="_blank" rel="noopener noreferrer"><code>{file}</code><span aria-hidden="true">↗</span></a>)}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section id="getting-started" class="content-section" aria-labelledby="started-heading">
        <div class="section-heading"><p class="section-label">A practical starting point</p><h2 id="started-heading">{isPokemon ? 'Recreate the setup on your hardware' : 'Get started'}</h2></div>
        <ol class="steps">
          {project.steps.map((step, index) => (
            <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
          ))}
        </ol>
        {isPokemon && (
          <aside class="config-note">
            <h3>Public code. Your own private inventory.</h3>
            <p>The default configuration directory is <code>~/.config/pokemon-go-automation</code>. Use <code>POGO_CONFIG_DIR</code> to point to another private directory. Your <code>pokemon-fleet.yaml</code> and per-device settings belong there. Runtime output uses <code>~/.local/state/pokemon-go-automation</code> by default, or your <code>POGO_STATE_DIR</code>. Keep real identifiers, machine addresses, trainer codes, screenshots, and run logs out of commits.</p>
            <a href={sourceHref('docs/configuration.md')} target="_blank" rel="noopener noreferrer">Read the configuration guide <span aria-hidden="true">↗</span></a>
          </aside>
        )}
      </section>

      {isPokemon && (
        <section id="documentation" class="content-section" aria-labelledby="docs-heading">
          <div class="section-heading"><p class="section-label">Build on the work</p><h2 id="docs-heading">Documentation for people and coding agents</h2></div>
          <p class="section-intro">Start a new AI coding session with <code>AGENTS.md</code> and the AI handoff guide. Then supply your own environment details privately. The guides connect each command to its configuration, implementation, and verification steps.</p>
          <div class="documentation-grid">
            {documentation.map((document) => (
              <a class="document-link" href={sourceHref(document.file)} target="_blank" rel="noopener noreferrer">
                <h3>{document.label}<span aria-hidden="true">↗</span></h3>
                <p>{document.description}</p>
                <code>{document.file}</code>
              </a>
            ))}
          </div>
        </section>
      )}

      <section id="project-notes" class="content-section project-notes" aria-labelledby="notes-heading">
        <div class="section-heading"><p class="section-label">Current context</p><h2 id="notes-heading">Project notes</h2></div>
        <p>{project.notes}</p>
      </section>

      <footer class="project-footer"><a href="/projects/">← Explore all projects</a><span>{project.title}</span></footer>
    </div>
  </div>
</Layout>

<style>
  .project-page { background: #0a0a0a; color: #f5f5f5; padding: 2.5rem 1.25rem 4rem; }
  .project-shell { max-width: 72rem; margin: 0 auto; }
  a { text-underline-offset: .25em; }
  a:focus-visible { outline: 2px solid #93c5fd; outline-offset: 5px; border-radius: 3px; }
  .back-link { font-size: .9rem; color: #a3a3a3; }
  .back-link:hover { color: #fff; }
  .project-hero { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 4rem; padding: 3.5rem 0; border-bottom: 1px solid #303030; align-items: start; }
  .eyebrow { display: flex; align-items: center; gap: .9rem; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #93c5fd; }
  .status { border: 1px solid #404040; border-radius: 99px; padding: .3rem .6rem; color: #d4d4d4; font-size: .65rem; letter-spacing: .06em; }
  h1 { font-size: clamp(2.5rem, 5.5vw, 4.3rem); line-height: 1.08; letter-spacing: -.045em; font-weight: 750; margin: 1.2rem 0 1.3rem; }
  .summary { font-size: 1.17rem; line-height: 1.7; color: #c2c2c2; max-width: 43rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.4rem; }
  .tags span { color: #a3a3a3; font-size: .75rem; border: 1px solid #303030; padding: .3rem .6rem; border-radius: 4px; }
  .project-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.8rem; }
  .action-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.3rem; font-size: .9rem; font-weight: 650; border-radius: 5px; padding: .8rem 1rem; border: 1px solid #404040; }
  .action-link:hover { background: #262626; }
  .action-link.primary { background: #2563eb; border-color: #2563eb; }
  .action-link.primary:hover { background: #3b82f6; }
  .page-nav { border-left: 1px solid #303030; padding-left: 1.5rem; margin-top: .3rem; }
  .page-nav p { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #737373; margin-bottom: 1rem; }
  .page-nav a { display: flex; gap: .8rem; font-size: .75rem; line-height: 1.5; color: #737373; padding: .45rem 0; }
  .page-nav span { color: #c2c2c2; font-size: .85rem; }
  .page-nav a:hover span { color: #93c5fd; }
  .content-section { padding: 3rem 0; border-bottom: 1px solid #262626; scroll-margin-top: 6rem; }
  .section-heading { margin-bottom: 1.6rem; }
  .section-label { font-size: .68rem; text-transform: uppercase; letter-spacing: .13em; color: #737373; font-weight: 750; margin-bottom: .6rem; }
  h2 { font-size: clamp(1.65rem, 3vw, 2.1rem); font-weight: 700; line-height: 1.25; letter-spacing: -.025em; }
  h3 { font-size: 1.05rem; line-height: 1.5; font-weight: 650; }
  p { line-height: 1.75; }
  .overview { display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: 3rem; }
  .prose { max-width: 47rem; color: #c2c2c2; }
  .prose p + p { margin-top: 1rem; }
  .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
  .feature { border-top: 1px solid #404040; padding: 1.2rem 0; }
  .feature-number { font-size: .7rem; color: #60a5fa; font-family: monospace; }
  .feature h3 { margin: .6rem 0; }
  .feature p { max-width: 32rem; color: #a3a3a3; font-size: .93rem; }
  .section-intro { max-width: 50rem; margin: -.3rem 0 1.8rem; color: #a3a3a3; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; overflow-wrap: anywhere; font-size: .85em; }
  .section-intro code, .config-note code { color: #d4d4d4; background: #222; border-radius: 3px; padding: .12rem .3rem; }
  .workflow-list { border: 1px solid #333; border-radius: 8px; overflow: hidden; }
  .workflow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: 2rem; padding: 1.6rem; scroll-margin-top: 6rem; }
  .workflow + .workflow { border-top: 1px solid #333; }
  .workflow:nth-child(odd) { background: #111; }
  .file-link { display: inline-flex; gap: .75rem; align-items: center; color: #93c5fd; font-size: 1.05rem; }
  .file-link:hover { text-decoration: underline; }
  .workflow h3 { margin: .65rem 0 .45rem; }
  .workflow-description p { color: #a3a3a3; font-size: .9rem; }
  .code-label, .implementation-links p { font-size: .67rem; color: #737373; text-transform: uppercase; letter-spacing: .07em; font-weight: 700; margin-bottom: .65rem; }
  pre { margin: 0; padding: .95rem; background: #070707; border: 1px solid #303030; border-radius: 5px; color: #e5e5e5; font-size: .86rem; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  pre code { font-size: 1em; }
  .implementation-links { margin-top: 1.2rem; }
  .implementation-links a { display: flex; align-items: center; gap: .7rem; width: fit-content; color: #a3a3a3; font-size: .9rem; margin-top: .3rem; }
  .implementation-links a:hover { color: #93c5fd; }
  .steps { list-style: none; padding: 0; margin: 0; max-width: 55rem; }
  .steps li { display: grid; grid-template-columns: 2.2rem 1fr; gap: 1rem; margin-top: 1.5rem; }
  .step-number { width: 2rem; height: 2rem; display: grid; place-items: center; font-family: monospace; font-size: .8rem; border: 1px solid #404040; border-radius: 50%; color: #93c5fd; }
  .steps h3 { margin-bottom: .4rem; }
  .steps p { color: #a3a3a3; font-size: .95rem; }
  .config-note { margin-top: 2rem; border-left: 3px solid #3b82f6; background: #111820; padding: 1.3rem 1.5rem; max-width: 58rem; }
  .config-note p { color: #a3a3a3; margin: .6rem 0 1rem; font-size: .93rem; }
  .config-note a { font-size: .85rem; color: #93c5fd; }
  .documentation-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .document-link { padding: 1.2rem; background: #141414; border: 1px solid #303030; border-radius: 5px; }
  .document-link:hover { border-color: #60a5fa; }
  .document-link h3 { display: flex; justify-content: space-between; gap: .5rem; font-size: .95rem; }
  .document-link h3 span { color: #737373; }
  .document-link p { font-size: .85rem; color: #a3a3a3; margin: .65rem 0 1rem; }
  .document-link code { color: #737373; font-size: .7rem; }
  .project-notes p:last-child { max-width: 56rem; color: #a3a3a3; font-size: .92rem; }
  .project-footer { display: flex; justify-content: space-between; gap: 2rem; padding-top: 2rem; font-size: .85rem; }
  .project-footer a { color: #93c5fd; }
  .project-footer span { color: #525252; }
  @media (max-width: 900px) {
    .project-hero { grid-template-columns: 1fr; gap: 2rem; padding: 2.2rem 0; }
    .page-nav { display: flex; gap: .6rem 1.3rem; flex-wrap: wrap; border-left: 0; border-top: 1px solid #303030; padding: 1rem 0 0; }
    .page-nav p { width: 100%; margin-bottom: 0; }
    .page-nav a { padding: 0; }
    .overview { grid-template-columns: 1fr; gap: 0; }
    .documentation-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .project-page { padding: 1.75rem 1.15rem 3rem; }
    .summary { font-size: 1.03rem; }
    .content-section { padding: 2.2rem 0; }
    .feature-grid, .workflow, .documentation-grid { grid-template-columns: 1fr; }
    .feature-grid { gap: .3rem; }
    .workflow { padding: 1.2rem; gap: 1.3rem; }
    .project-actions { align-items: stretch; flex-direction: column; }
    .project-footer span { display: none; }
    .config-note { padding: 1rem; }
  }
</style>
