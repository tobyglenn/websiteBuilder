---
import Layout from '../../layouts/Layout.astro';
import { pokemonRepository, projectHref, projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const isPokemon = project.slug === 'pokemon-go-automation';
const sourceHref = (file: string) => `${pokemonRepository}/blob/main/${file}`;
const documentation = [
  { file: 'README.md', label: 'Start here', description: 'Installation, entry points, and the project overview.' },
  { file: 'docs/getting-started.md', label: 'First device', description: 'Prepare your environment and run the initial checks.' },
  { file: 'docs/configuration.md', label: 'Private configuration', description: 'Inventory, connection settings, and generic examples.' },
  { file: 'docs/workflows.md', label: 'Workflow guide', description: 'Options and operating steps for each command.' },
  { file: 'docs/architecture.md', label: 'Architecture', description: 'How commands, fleet routing, and device workers fit together.' },
  { file: 'docs/file-reference.md', label: 'File reference', description: 'Find the source file responsible for each part of the system.' },
  { file: 'docs/ai-handoff.md', label: 'AI handoff', description: 'Context and reproduction steps for another coding agent.' },
  { file: 'docs/testing.md', label: 'Verification', description: 'Separate code checks from live physical-device evidence.' },
  { file: 'docs/privacy.md', label: 'Privacy', description: 'Keep personal inventory and runtime data out of the public repository.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': isPokemon ? 'SoftwareSourceCode' : 'CreativeWork',
  name: project.title,
  description: project.description,
  url: `https://tobyonfitnesstech.com${projectHref(project.slug)}`,
  author: { '@type': 'Person', name: 'Toby Glenn Peters', url: 'https://tobyonfitnesstech.com/about/' },
  image: project.heroImage ? `https://tobyonfitnesstech.com${project.heroImage.src}` : undefined,
  ...(isPokemon ? { codeRepository: pokemonRepository, programmingLanguage: 'Python' } : {}),
};
---

<Layout
  title={`${project.title} project guide | Toby on Fitness Tech`}
  description={project.description}
  image={project.heroImage?.src}
  jsonLd={schema}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Projects', url: '/projects/' }, { name: project.title, url: projectHref(project.slug) }]}
>
  <div class="project-page">
    <div class="project-shell">
      <a class="back-link" href="/projects/">← All Projects</a>

      <header class="project-hero">
        <div class="hero-copy">
          <div class="eyebrow"><span>{project.group}</span><span class="status">{project.status}</span></div>
          <h1>{project.title}</h1>
          <p class="summary">{project.description}</p>
          <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
          <div class="project-actions">
            {project.links.map((link, index) => (
              <a
                class:list={['action-link', { primary: index === 0 }]}
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                data-analytics-event="project_destination_click"
                data-analytics-content-type="project"
                data-analytics-content-slug={project.slug}
                data-analytics-content-title={project.title}
              >
                {link.label}<span aria-hidden="true">{link.href.startsWith('http') ? '↗' : '→'}</span>
              </a>
            ))}
          </div>
        </div>
        <nav class="page-nav" aria-label={`${project.title} page sections`}>
          <p>On this page</p>
          <a href="#overview"><span>What it is</span></a>
          {project.featuredYoutubeId && <a href="#featured-video"><span>Featured episode</span></a>}
          {project.characters && <a href="#characters"><span>Cast & characters</span></a>}
          {project.episodes && <a href="#episodes"><span>Episodes & videos</span></a>}
          {project.gallery && <a href="#gallery"><span>Screenshots & media</span></a>}
          <a href="#capabilities"><span>How it works</span></a>
          {project.workflowFiles && <a href="#workflow-files"><span>Files & commands</span></a>}
          {project.productionNotes && <a href="#production-pipeline"><span>Pipeline & tech</span></a>}
          <a href="#getting-started"><span>{isPokemon ? 'Recreate setup' : 'Get started'}</span></a>
          {isPokemon && <a href="#documentation"><span>Documentation</span></a>}
          <a href="#project-notes"><span>Project notes</span></a>
        </nav>
      </header>

      {project.heroImage && (
        <section class="hero-visual-section" aria-label={`${project.title} preview`}>
          <figure class:list={['hero-figure', { portrait: project.heroImage.aspect === 'portrait' }]}>
            <div class="hero-image-frame">
              <img
                src={project.heroImage.src}
                alt={project.heroImage.alt}
                loading="eager"
                decoding="async"
              />
            </div>
            {project.heroImage.caption && (
              <figcaption class="hero-caption">
                <span class="caption-dot" aria-hidden="true"></span>
                <span>{project.heroImage.caption}</span>
              </figcaption>
            )}
          </figure>
        </section>
      )}

      {project.featuredYoutubeId && (
        <section id="featured-video" class="content-section" aria-labelledby="featured-video-heading">
          <div class="section-heading">
            <p class="section-label">Featured Release</p>
            <h2 id="featured-video-heading">Watch the latest episode</h2>
          </div>
          <div class="video-embed-container">
            <div class="video-embed-frame">
              <iframe
                src={`https://www.youtube.com/embed/${project.featuredYoutubeId}`}
                title={`Watch ${project.title}`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </section>
      )}

      <section id="overview" class="content-section overview" aria-labelledby="overview-heading">
        <div class="section-heading"><p class="section-label">The project</p><h2 id="overview-heading">What it is</h2></div>
        <div class="prose">{project.overview.map((paragraph) => <p>{paragraph}</p>)}</div>
      </section>

      {project.characters && (
        <section id="characters" class="content-section" aria-labelledby="characters-heading">
          <div class="section-heading">
            <p class="section-label">The Cast</p>
            <h2 id="characters-heading">Key characters & roles</h2>
          </div>
          <div class="character-grid">
            {project.characters.map((char) => (
              <article class="character-card">
                {char.image && (
                  <div class="character-avatar-wrap">
                    <img src={char.image} alt={char.name} loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="character-details">
                  <div class="character-meta">
                    <h3>{char.name}</h3>
                    <span class="character-role">{char.role}</span>
                  </div>
                  {char.voiceActor && (
                    <div class="voice-badge">
                      <span class="voice-icon" aria-hidden="true">🎙️</span>
                      <code>{char.voiceActor}</code>
                    </div>
                  )}
                  <p>{char.description}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {project.episodes && (
        <section id="episodes" class="content-section" aria-labelledby="episodes-heading">
          <div class="section-heading">
            <p class="section-label">Releases & Catalog</p>
            <h2 id="episodes-heading">Popular episodes & videos</h2>
          </div>
          <div class="episodes-list">
            {project.episodes.map((ep) => (
              <article class:list={['episode-card', { short: ep.isShort }]}>
                <div class="episode-header">
                  <div class="episode-title-group">
                    <span class:list={['episode-badge', { 'short-badge': ep.isShort }]}>
                      {ep.number || (ep.isShort ? 'Short' : 'Episode')}
                    </span>
                    <h3>{ep.title}</h3>
                  </div>
                  {ep.subtitle && <p class="episode-subtitle">{ep.subtitle}</p>}
                </div>
                <p class="episode-desc">{ep.description}</p>
                {ep.highlights && ep.highlights.length > 0 && (
                  <div class="episode-highlights">
                    <p class="highlights-label">Highlights</p>
                    <ul>
                      {ep.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  </div>
                )}
                {ep.youtubeUrl && (
                  <div class="episode-footer">
                    <a
                      href={ep.youtubeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="watch-btn"
                    >
                      ▶ Watch on YouTube <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      {project.gallery && (
        <section id="gallery" class="content-section" aria-labelledby="gallery-heading">
          <div class="section-heading">
            <p class="section-label">Media & Artifacts</p>
            <h2 id="gallery-heading">Screenshots & production checks</h2>
          </div>
          <div class="gallery-grid">
            {project.gallery.map((item) => (
              <figure class="gallery-item">
                <div class="gallery-frame">
                  <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <strong>{item.title}</strong>
                  <p>{item.description}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <section id="capabilities" class="content-section" aria-labelledby="capabilities-heading">
        <div class="section-heading"><p class="section-label">Inside the project</p><h2 id="capabilities-heading">How it works</h2></div>
        <div class="feature-grid">
          {project.features.map((feature, index) => (
            <article class="feature">
              <span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </section>

      {project.workflowFiles && (
        <section id="workflow-files" class="content-section" aria-labelledby="files-heading">
          <div class="section-heading"><p class="section-label">The public entry points</p><h2 id="files-heading">One file for each workflow</h2></div>
          <p class="section-intro">Run these commands from the repository in your Python environment. The examples preview workflow routing; <code>fleet.py status</code> checks readiness. Each entry file links to the public source.</p>
          <div class="workflow-list">
            {project.workflowFiles.map((workflow) => (
              <article class="workflow" id={workflow.file.replace('.py', '')}>
                <div class="workflow-description">
                  <a class="file-link" href={sourceHref(workflow.file)} target="_blank" rel="noopener noreferrer"><code>{workflow.file}</code><span aria-hidden="true">↗</span></a>
                  <h3>{workflow.title}</h3>
                  <p>{workflow.description}</p>
                </div>
                <div class="workflow-source">
                  <p class="code-label">{workflow.file === 'fleet.py' ? 'Readiness check' : 'Preview the plan'}</p>
                  <pre><code>{workflow.command}</code></pre>
                  {workflow.implementation.length > 0 && (
                    <div class="implementation-links">
                      <p>Implementation</p>
                      {workflow.implementation.map((file) => <a href={sourceHref(file)} target="_blank" rel="noopener noreferrer"><code>{file}</code><span aria-hidden="true">↗</span></a>)}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {project.productionNotes && (
        <section id="production-pipeline" class="content-section" aria-labelledby="pipeline-heading">
          <div class="section-heading">
            <p class="section-label">Behind the Scenes</p>
            <h2 id="pipeline-heading">Production architecture & pipeline specs</h2>
          </div>
          <div class="pipeline-grid">
            {project.productionNotes.map((note) => (
              <article class="pipeline-card">
                <h3>{note.title}</h3>
                <p>{note.content}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      <section id="getting-started" class="content-section" aria-labelledby="started-heading">
        <div class="section-heading"><p class="section-label">A practical starting point</p><h2 id="started-heading">{isPokemon ? 'Recreate the setup on your hardware' : 'Get started'}</h2></div>
        <ol class="steps">
          {project.steps.map((step, index) => (
            <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
          ))}
        </ol>
        {isPokemon && (
          <aside class="config-note">
            <h3>Public code. Your own private inventory.</h3>
            <p>The default configuration directory is <code>~/.config/pokemon-go-automation</code>. Use <code>POGO_CONFIG_DIR</code> to point to another private directory. Your <code>pokemon-fleet.yaml</code> and per-device settings belong there. Runtime output uses <code>~/.local/state/pokemon-go-automation</code> by default, or your <code>POGO_STATE_DIR</code>. Keep real identifiers, machine addresses, trainer codes, screenshots, and run logs out of commits.</p>
            <a href={sourceHref('docs/configuration.md')} target="_blank" rel="noopener noreferrer">Read the configuration guide <span aria-hidden="true">↗</span></a>
          </aside>
        )}
      </section>

      {isPokemon && (
        <section id="documentation" class="content-section" aria-labelledby="docs-heading">
          <div class="section-heading"><p class="section-label">Build on the work</p><h2 id="docs-heading">Documentation for people and coding agents</h2></div>
          <p class="section-intro">Start a new AI coding session with <code>AGENTS.md</code> and the AI handoff guide. Then supply your own environment details privately. The guides connect each command to its configuration, implementation, and verification steps.</p>
          <div class="documentation-grid">
            {documentation.map((document) => (
              <a class="document-link" href={sourceHref(document.file)} target="_blank" rel="noopener noreferrer">
                <h3>{document.label}<span aria-hidden="true">↗</span></h3>
                <p>{document.description}</p>
                <code>{document.file}</code>
              </a>
            ))}
          </div>
        </section>
      )}

      <section id="project-notes" class="content-section project-notes" aria-labelledby="notes-heading">
        <div class="section-heading"><p class="section-label">Current context</p><h2 id="notes-heading">Project notes</h2></div>
        <p>{project.notes}</p>
      </section>

      <footer class="project-footer"><a href="/projects/">← Explore all projects</a><span>{project.title}</span></footer>
    </div>
  </div>
</Layout>

<style>
  .project-page { background: #0a0a0a; color: #f5f5f5; padding: 2.5rem 1.25rem 4rem; }
  .project-shell { max-width: 72rem; margin: 0 auto; }
  a { text-underline-offset: .25em; }
  a:focus-visible { outline: 2px solid #93c5fd; outline-offset: 5px; border-radius: 3px; }
  .back-link { font-size: .9rem; color: #a3a3a3; }
  .back-link:hover { color: #fff; }
  .project-hero { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 4rem; padding: 3.5rem 0 2.5rem; border-bottom: 1px solid #303030; align-items: start; }
  .eyebrow { display: flex; align-items: center; gap: .9rem; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #93c5fd; }
  .status { border: 1px solid #404040; border-radius: 99px; padding: .3rem .6rem; color: #d4d4d4; font-size: .65rem; letter-spacing: .06em; }
  h1 { font-size: clamp(2.5rem, 5.5vw, 4.3rem); line-height: 1.08; letter-spacing: -.045em; font-weight: 750; margin: 1.2rem 0 1.3rem; }
  .summary { font-size: 1.17rem; line-height: 1.7; color: #c2c2c2; max-width: 43rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.4rem; }
  .tags span { color: #a3a3a3; font-size: .75rem; border: 1px solid #303030; padding: .3rem .6rem; border-radius: 4px; }
  .project-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.8rem; }
  .action-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.3rem; font-size: .9rem; font-weight: 650; border-radius: 5px; padding: .8rem 1rem; border: 1px solid #404040; }
  .action-link:hover { background: #262626; }
  .action-link.primary { background: #2563eb; border-color: #2563eb; }
  .action-link.primary:hover { background: #3b82f6; }
  .page-nav { border-left: 1px solid #303030; padding-left: 1.5rem; margin-top: .3rem; }
  .page-nav p { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #737373; margin-bottom: 1rem; }
  .page-nav a { display: flex; gap: .8rem; font-size: .75rem; line-height: 1.5; color: #737373; padding: .45rem 0; }
  .page-nav span { color: #c2c2c2; font-size: .85rem; }
  .page-nav a:hover span { color: #93c5fd; }

  /* Hero Visual */
  .hero-visual-section { padding: 2.5rem 0; border-bottom: 1px solid #262626; }
  .hero-figure { margin: 0; }
  .hero-figure.portrait { max-width: 28rem; margin: 0 auto; }
  .hero-image-frame { border-radius: 12px; overflow: hidden; border: 1px solid #333; background: #111; box-shadow: 0 20px 40px -15px rgba(0,0,0,0.7); }
  .hero-image-frame img { display: block; width: 100%; height: auto; object-fit: cover; }
  .hero-caption { display: flex; align-items: center; gap: .6rem; margin-top: .9rem; font-size: .85rem; color: #a3a3a3; }
  .caption-dot { width: 6px; height: 6px; border-radius: 50%; background: #3b82f6; shrink: 0; }

  /* Video Embed */
  .video-embed-container { max-width: 54rem; margin-top: 1.2rem; }
  .video-embed-frame { position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 12px; overflow: hidden; border: 1px solid #333; background: #000; box-shadow: 0 20px 40px -15px rgba(0,0,0,0.8); }
  .video-embed-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* Characters Grid */
  .character-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .character-card { background: #121212; border: 1px solid #262626; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; transition: border-color .15s; }
  .character-card:hover { border-color: #3b82f6; }
  .character-avatar-wrap { width: 100%; aspect-ratio: 1/1; overflow: hidden; background: #1a1a1a; }
  .character-avatar-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .character-card:hover .character-avatar-wrap img { transform: scale(1.03); }
  .character-details { padding: 1.2rem; flex: 1; display: flex; flex-direction: column; }
  .character-meta { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; margin-bottom: .4rem; }
  .character-meta h3 { font-size: 1.2rem; font-weight: 700; color: #fff; margin: 0; }
  .character-role { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: #93c5fd; font-weight: 600; }
  .voice-badge { display: inline-flex; align-items: center; gap: .4rem; background: #1e293b; border: 1px solid #334155; padding: .2rem .5rem; border-radius: 4px; width: fit-content; margin: .4rem 0 .7rem; }
  .voice-badge code { font-size: .72rem; color: #cbd5e1; }
  .character-details p { font-size: .88rem; color: #a3a3a3; line-height: 1.6; margin: 0; }

  /* Episodes List */
  .episodes-list { display: flex; flex-direction: column; gap: 1.2rem; margin-top: 1.5rem; }
  .episode-card { background: #121212; border: 1px solid #282828; border-radius: 10px; padding: 1.5rem; transition: border-color .15s; }
  .episode-card:hover { border-color: #3b82f6; }
  .episode-card.short { border-left: 3px solid #60a5fa; }
  .episode-header { margin-bottom: .8rem; }
  .episode-title-group { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .episode-badge { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; background: #1e3a8a; color: #93c5fd; padding: .25rem .6rem; border-radius: 4px; }
  .episode-badge.short-badge { background: #312e81; color: #c7d2fe; }
  .episode-title-group h3 { font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0; }
  .episode-subtitle { font-size: .85rem; color: #94a3b8; margin-top: .3rem; font-weight: 500; }
  .episode-desc { font-size: .95rem; color: #d4d4d4; line-height: 1.65; margin: .5rem 0 1rem; }
  .episode-highlights { background: #171717; border-radius: 6px; padding: 1rem 1.2rem; margin-bottom: 1.2rem; border-left: 2px solid #404040; }
  .highlights-label { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: #737373; font-weight: 700; margin-bottom: .4rem; }
  .episode-highlights ul { margin: 0; padding-left: 1.2rem; color: #a3a3a3; font-size: .88rem; line-height: 1.6; }
  .episode-footer { display: flex; justify-content: flex-end; }
  .watch-btn { display: inline-flex; align-items: center; gap: .5rem; font-size: .88rem; font-weight: 650; color: #93c5fd; background: #1e293b; border: 1px solid #334155; padding: .5rem 1rem; border-radius: 6px; }
  .watch-btn:hover { background: #2563eb; color: #fff; border-color: #2563eb; }

  /* Gallery Grid */
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .gallery-item { margin: 0; background: #121212; border: 1px solid #262626; border-radius: 10px; overflow: hidden; }
  .gallery-frame { aspect-ratio: 16/9; overflow: hidden; background: #000; }
  .gallery-frame img { width: 100%; height: 100%; object-fit: cover; }
  .gallery-item figcaption { padding: 1.2rem; }
  .gallery-item strong { display: block; font-size: 1rem; color: #fff; margin-bottom: .3rem; }
  .gallery-item p { font-size: .85rem; color: #a3a3a3; line-height: 1.55; margin: 0; }

  /* Pipeline Grid */
  .pipeline-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr)); gap: 1.2rem; margin-top: 1.5rem; }
  .pipeline-card { background: #121212; border: 1px solid #2a2a2a; border-radius: 8px; padding: 1.4rem; }
  .pipeline-card h3 { font-size: 1.05rem; font-weight: 700; color: #93c5fd; margin: 0 0 .6rem; }
  .pipeline-card p { font-size: .9rem; color: #a3a3a3; line-height: 1.65; margin: 0; }

  /* General Content Sections */
  .content-section { padding: 3rem 0; border-bottom: 1px solid #262626; scroll-margin-top: 6rem; }
  .section-heading { margin-bottom: 1.6rem; }
  .section-label { font-size: .68rem; text-transform: uppercase; letter-spacing: .13em; color: #737373; font-weight: 750; margin-bottom: .6rem; }
  h2 { font-size: clamp(1.65rem, 3vw, 2.1rem); font-weight: 700; line-height: 1.25; letter-spacing: -.025em; }
  h3 { font-size: 1.05rem; line-height: 1.5; font-weight: 650; }
  p { line-height: 1.75; }
  .overview { display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: 3rem; }
  .prose { max-width: 47rem; color: #c2c2c2; }
