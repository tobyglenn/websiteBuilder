---
import Layout from '../../layouts/Layout.astro';
import SpeedianceWorkoutHub from '../../components/SpeedianceWorkoutHub.jsx';

if (import.meta.env.PUBLIC_WORKOUT_HUB_ENABLED !== 'true') {
  return Astro.redirect('/speediance/', 302);
}
---

<Layout
  title="Speediance Workout Hub | 53 Shared Custom Workouts"
  description="Browse 53 custom Speediance workouts set by set, with real weights, reps and volume. Export any routine as JSON or open it straight in the Speediance app."
  canonicalUrl="https://tobyonfitnesstech.com/speediance/workouts/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Speediance', url: '/speediance/' },
    { name: 'Workout Hub', url: '/speediance/workouts/' },
  ]}
>
  <SpeedianceWorkoutHub client:load />
</Layout>
