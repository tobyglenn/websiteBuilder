---
import Layout from '../layouts/Layout.astro';
import { games, gameHref, playHref, releasesFor, journalHref } from '../lib/gameJournal.mjs';
import { projectGroups, projectHref } from '../data/projects';
import '../styles/game-showcase.css';
const others = projectGroups.filter(group=>['games','roblox'].includes(group.id)).flatMap(group=>group.projects).filter(project=>!games.some(game=>game.slug===project.slug));
---
<Layout title="Our Roblox Worlds — Play, Watch & Follow the Build | Toby on Fitness Tech" description="Explore Wild Rebellion and Monstrum World: Roblox games, real gameplay, the stories behind their creation, and the latest release journals." breadcrumbs={[{name:'Home',url:'/'},{name:'Games',url:'/games/'}]}>
<div class="game-world" data-pagefind-body data-pagefind-filter="type:Games"><div class="gw-wrap">
<div class="gw-top"><a href="/projects/">← All projects</a><a href="/games/journal/">Development journal ↗</a></div>
<header data-page-intro class="gw-journal-title"><p class="gw-eyebrow">Imagined, built, played</p><h1 data-page-title>Worlds with a story.{' '}Adventures you can join.</h1><p>Meet Lilly’s characters in Wild Rebellion. Raise a team in Monstrum World. Watch the games in motion and follow how they grow, one idea and one release at a time.</p></header>
<div class="gw-grid">{games.map(game=>{const release=releasesFor(game.slug)[0];return <article class="gw-card"><a href={gameHref(game)}><img src={game.hero.src} alt={game.hero.alt} width="800" height="450"/></a><div class="gw-card-body"><p class="gw-eyebrow">{game.eyebrow}</p><h2 class="text-3xl font-bold">{game.title}</h2><p>{game.summary}</p><div class="gw-actions"><a class="gw-button primary" href={gameHref(game)} data-analytics-event="project_card_click" data-analytics-content-slug={game.slug}>Explore & watch →</a><a class="gw-button" href={playHref(game)} target="_blank" rel="noopener noreferrer" data-analytics-event="project_destination_click" data-analytics-content-slug={game.slug}>Play on Roblox ↗</a></div>{release && <p class="gw-release-latest">Release journal: <a href={journalHref(release)}>{release.title} →</a></p>}</div></article>})}</div>
<section class="gw-section"><div class="gw-heading"><div><p class="gw-eyebrow">The story behind the screen</p><h2>See how we bring them to life.</h2></div><p>Original drawings, companion systems, family playtests, interface changes, and music. The journal connects the creative work to what you can play.</p></div><a class="gw-button primary" href="/games/journal/">Read the development journal →</a></section>
{others.length>0 && <section class="gw-section"><div class="gw-heading"><h2>More games to explore.</h2></div><div class="gw-grid">{others.map(project=><article class="gw-card"><div class="gw-card-body"><h3><a href={projectHref(project.slug)}>{project.title}</a></h3><p>{project.description}</p><a class="gw-text-link" href={projectHref(project.slug)}>Explore project →</a>{project.links.filter(link=>link.href.includes('roblox.com/games/')).map(link=><div><a class="gw-text-link" href={link.href} data-analytics-event="project_destination_click" data-analytics-content-slug={project.slug}>Play on Roblox ↗</a></div>)}</div></article>)}</div></section>}
<footer class="gw-footer"><a class="gw-button" href="/projects/lilly/">Watch Lilly Plays →</a></footer>
</div></div></Layout>
