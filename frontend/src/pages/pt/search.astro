---
import Layout from '../../layouts/Layout.astro';
import { Search as SearchIcon } from 'lucide-react';
---

<Layout title="Busca - Toby sobre tecnologia fitness" description="Busque vídeos, posts do blog e análises de equipamentos no TobyOnFitnessTech." noindex={true}>
  <div class="container mx-auto px-4 py-6 min-h-[60vh]">
    
    <div data-page-intro class="mb-4 border-b border-neutral-800 pb-8">
        <h1 data-page-title class="text-3xl md:text-4xl font-bold mb-4 flex items-center gap-3">
            <SearchIcon size={32} class="text-blue-500" /> Resultados da busca
        </h1>
        <p id="search-summary" class="text-neutral-400 text-lg">Digite acima um termo de busca para encontrar vídeos e artigos.</p>
    </div>

    <form id="standalone-search-form" data-copy-prompt="Digite acima um termo de busca para encontrar vídeos e artigos." data-copy-loading="Buscando…" data-copy-found="Encontrados {total} resultados para &quot;{q}&quot;" data-copy-failed="Não foi possível carregar a busca. Tente novamente." data-copy-read="Ler análise →" action="/pt/search/" method="get" class="mb-8 flex max-w-2xl gap-2">
      <label for="standalone-query" class="sr-only">Pesquisar vídeos e artigos</label>
      <input id="standalone-query" name="q" type="search" maxlength="120" class="min-w-0 flex-1 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-white" />
      <button type="submit" aria-label="Pesquisar vídeos e artigos" title="Pesquisar vídeos e artigos" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-blue-600 text-white hover:bg-blue-500">
        <SearchIcon size={20} />
      </button>
    </form>

    <div id="no-results" class="hidden text-center py-12 bg-neutral-900/50 rounded-xl border border-neutral-800 border-dashed">
        <p class="text-neutral-500 text-lg">Nenhuma correspondência encontrada. Tente outra palavra-chave.</p>
    </div>

    <div id="results-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <div id="video-results-section" class="hidden">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#ef4444" class="inline"><polygon points="5,3 19,12 5,21"/></svg>
                Vídeos
            </h2>
            <div id="video-results" class="space-y-6"></div>
        </div>

        <div id="blog-results-section" class="hidden">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                Artigos
            </h2>
            <div id="blog-results" class="space-y-6"></div>
        </div>

    </div>
  </div>
</Layout>

<script>
  import '../../lib/standaloneSearch.js';
</script>
