---
import Layout from '../../layouts/Layout.astro';
import { LISTING_BLOG_POSTS } from '../../lib/blogPosts';
import { ArrowRight, BarChart3, HeartPulse, Moon, Scale, Watch } from 'lucide-react';

const wearablePosts = LISTING_BLOG_POSTS
  .filter((post) => /whoop|oura|garmin|wearable|recovery|sleep|hrv/i.test([
    post.title,
    post.excerpt,
    post.category,
    ...(post.tags || []),
  ].join(' ')))
  .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime());

const preferredSlugs = [
  'whoop-5-not-smaller-review',
  'oura-vs-whoop-sleep-comparison',
  'garmin-and-whoop-what-each-is-actually-for',
  'whoop-recovery-scores-explained',
];

const featuredPosts = preferredSlugs
  .map((slug) => wearablePosts.find((post) => post.slug === slug))
  .filter((post): post is (typeof wearablePosts)[number] => Boolean(post));

for (const post of wearablePosts) {
  if (featuredPosts.length >= 4) break;
  if (!featuredPosts.some((featured) => featured?.slug === post.slug)) featuredPosts.push(post);
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Análises de Wearables e Dados de Recuperação',
  description: 'Comparações práticas de WHOOP, Oura, Garmin, sono e recuperação, apoiadas pelos dados reais de treino de Toby Peters.',
  url: 'https://tobyonfitnesstech.com/pt/wearables/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: featuredPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://tobyonfitnesstech.com/blog/${post.slug}/`,
      name: post.title,
    })),
  },
};
---

<Layout
  title="Análises de Wearables: WHOOP, Oura e Garmin Comparados"
  description="Comparações práticas de WHOOP, Oura e Garmin com dados ao vivo de recuperação, HRV, sono e treino, de um único atleta usando os dispositivos em conjunto."
  image="/images/gear/whoop-5.0.jpg"
  jsonLd={articleSchema}
  breadcrumbs={[{ name: 'Início', url: '/pt/' }, { name: 'Wearables', url: '/pt/wearables/' }]}

  lang="pt-BR"
  translationBase="/wearables/"
>
  <section class="relative flex min-h-[460px] items-end overflow-hidden border-b border-neutral-800">
    <img
      src="/images/gear/whoop-5.0.jpg"
      alt="Wearable WHOOP usado para o acompanhamento de recuperação do Toby"
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/55 to-transparent"></div>
    <div class="container relative z-10 mx-auto px-4 pb-14 pt-32">
      <div class="max-w-3xl">
        <div class="mb-4 flex items-center gap-2 text-sm font-semibold text-cyan-300">
          <Watch size={18} />
          Testes independentes de wearables
        </div>
        <h1 class="mb-5 text-4xl font-bold leading-tight text-white md:text-6xl">
          Análises de Wearables e Dados de Recuperação
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-neutral-200 md:text-xl">
          WHOOP, Oura e Garmin testados na mesma rotina de treinos. As comparações aqui conectam as alegações dos produtos a dados de sono, HRV, corrida, musculação e BJJ.
        </p>
      </div>
    </div>
  </section>

  <div class="bg-neutral-950">
    <section class="border-b border-neutral-900 py-12">
      <div class="container mx-auto px-4">
        <div class="mb-7 max-w-2xl">
          <p class="mb-2 text-xs font-semibold uppercase text-cyan-400">Comece pela decisão</p>
          <h2 class="text-2xl font-bold text-white md:text-3xl">O que você está realmente tentando medir?</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <a href="/pt/wearables/whoop-5-vs-4-vs-oura/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-cyan-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="whoop-comparison" data-analytics-content-title="WHOOP 5 vs 4 vs Oura">
            <Moon size={22} class="mb-5 text-cyan-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-cyan-300">WHOOP 5 vs 4 vs Oura</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Espessura, bateria, pulseiras, sono, recuperação e o papel que o Garmin desempenha ao lado deles.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-400">Abrir a comparação <ArrowRight size={15} /></span>
          </a>
          <a href="/pt/blog/garmin-and-whoop-what-each-is-actually-for/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-green-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="training-comparison" data-analytics-content-title="treino e corrida">
            <HeartPulse size={22} class="mb-5 text-green-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-green-300">Treino e corrida</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Garmin para o treino em si, WHOOP para a resposta de recuperação ao redor dele.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-green-400">Comparar funções no treino <ArrowRight size={15} /></span>
          </a>
          <a href="/pt/compare-trackers/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-amber-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="tracker-guide" data-analytics-content-title="escolha um rastreador">
            <Scale size={22} class="mb-5 text-amber-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-amber-300">Escolha um dispositivo</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Use o guia de rastreadores quando orçamento, assinaturas e objetivos de treino importam juntos.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400">Abrir guia de rastreadores <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-neutral-900 py-14">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="mb-2 text-xs font-semibold uppercase text-blue-400">Guias para leitores</p>
            <h2 class="text-2xl font-bold text-white md:text-3xl">Comparações de wearables e anotações de campo</h2>
          </div>
          <a href="/pt/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300">Todos os artigos <ArrowRight size={15} /></a>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {featuredPosts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="group overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 hover:border-blue-500/60"
              data-analytics-event="content_card_click"
              data-analytics-content-type="blog"
              data-analytics-content-slug={post.slug}
              data-analytics-content-title={post.title}
            >
              <div class="aspect-video overflow-hidden bg-neutral-800">
                {post.image && <img src={post.image} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />}
              </div>
              <div class="p-5">
                <p class="mb-2 text-xs font-semibold text-blue-400">{post.category}</p>
                <h3 class="mb-3 line-clamp-3 text-sm font-semibold leading-snug text-white group-hover:text-blue-300">{post.title}</h3>
                <p class="line-clamp-3 text-xs leading-relaxed text-neutral-500">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14">
      <div class="container mx-auto grid gap-10 px-4 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase text-emerald-400">Os números por trás das análises</p>
          <h2 class="mb-4 text-3xl font-bold text-white">Veja os dados de recuperação, não apenas a opinião sobre o produto</h2>
          <p class="max-w-xl leading-relaxed text-neutral-400">
            As páginas ao vivo mostram os mesmos sinais de recuperação, sono e treino discutidos nas análises. Isso torna possível ver como os dispositivos se comportam ao longo de semanas reais, em vez de um único teste controlado.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/pt/whoop/" class="rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-emerald-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="/pt/whoop/" data-analytics-content-title="dados WHOOP ao vivo">
            <HeartPulse size={22} class="mb-4 text-emerald-400" />
            <h3 class="mb-2 font-semibold text-white">Recuperação WHOOP ao vivo</h3>
            <p class="mb-4 text-sm text-neutral-400">HRV, frequência cardíaca em repouso, desempenho do sono e tendências de recuperação.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400">Ver dados de recuperação <ArrowRight size={15} /></span>
          </a>
          <a href="/pt/sleep/" class="rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-violet-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="/pt/sleep/" data-analytics-content-title="dados de sono">
            <BarChart3 size={22} class="mb-4 text-violet-400" />
            <h3 class="mb-2 font-semibold text-white">Dados de sono</h3>
            <p class="mb-4 text-sm text-neutral-400">Padrões noturnos e o contexto de recuperação em torno da carga de treino.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-violet-400">Ver tendências de sono <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>