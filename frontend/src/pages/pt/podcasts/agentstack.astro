---
import '../../../styles/podcast-archive.css';
import { compactPodcastSummary } from '../../../lib/podcastMeta';
import { imageVariants } from '../../../lib/imageVariants.mjs';
import Layout from '../../../layouts/Layout.astro';
import PodcastSubscribeButtons from '../../../components/PodcastSubscribeButtons.jsx';
import {
  ensureEpisodeFromFallbackFeed,
  extractAttr,
  extractChannelItems,
  extractTag,
  fetchPinnedGitHubRawText,
  normalizeEpisodeTitle,
  parseEpisodeNumber,
} from '../../../lib/openclawFeed';
import { resolvePublicAsset } from '../../../lib/publicAssets';

const LANG = 'pt';
const feedUrl = `https://raw.githubusercontent.com/grayking-creator/openclaw-podcast/main/translations/feed_${LANG}.xml`;
const publicFeedUrl = `https://tobyonfitnesstech.com/${LANG}/podcasts/feed.xml`;

interface Episode {
  episodeNum: number;
  title: string;
  description: string;
  pubDate: string;
  audioUrl: string;
  duration: string;
  showNotesUrl: string;
  coverImage: string;
}

function formatDate(raw: string): string {
  try {
    const d = new Date(raw);
    return d.toLocaleDateString('pt-BR', { month: 'long', day: 'numeric', year: 'numeric' });
  } catch {
    return raw;
  }
}

let episodes: Episode[] = [];
let fetchError = false;

try {
  const xml = await fetchPinnedGitHubRawText(feedUrl);

  let items = extractChannelItems(xml);
  items = await ensureEpisodeFromFallbackFeed(items, 0);

  for (const item of items) {
    const title = normalizeEpisodeTitle(extractTag(item, 'title'));
    const description = extractTag(item, 'description');
    const pubDateRaw = extractTag(item, 'pubDate');
    const audioUrl = extractAttr(item, 'enclosure', 'url');
    const duration = extractTag(item, 'itunes:duration');
    const link = extractTag(item, 'link');
    const showNotesUrl = link;
    const pubDate = formatDate(pubDateRaw);
    const episodeNum = parseEpisodeNumber(item);
    const baseEpNum = String(episodeNum).padStart(3, '0');
    const localeCover = `/images/podcast/episode_${baseEpNum}_cover_pt.png`;
    const fallbackCover = `/images/podcast/episode_${baseEpNum}_cover.png`;
    const coverImage = resolvePublicAsset(
      [localeCover, fallbackCover],
      '/images/podcast/show_art_pt.png',
    );

    episodes.push({ episodeNum, title, description, pubDate, audioUrl, duration, showNotesUrl, coverImage });
  }

  episodes.sort((a, b) => b.episodeNum - a.episodeNum);
} catch (err) {
  fetchError = true;
  console.error('[pt/podcasts/agentstack.astro] RSS fetch failed:', err);
}
---

<Layout
  title="AgentStack Daily Podcast | Toby on Fitness Tech"
  description="Episódios diários de IA sobre desempenho de LLM, avaliações, notícias de IA, IA local, hardware, segurança e o ecossistema AgentStack."
  lang={LANG}
  image="/images/podcast/show_art_pt.png"
  canonicalUrl="https://tobyonfitnesstech.com/pt/podcasts/agentstack/"
  episodeSlug="agentstack"
>
  <div class="podcast-list max-w-4xl mx-auto px-4 py-6">
    <!-- Hero -->
    <div class="podcast-intro-grid flex items-start gap-4 mb-6">
      <img src="/images/podcast/show_art_pt.png" {...imageVariants("/images/podcast/show_art_pt.png", "176px")} alt="AgentStack Daily" class="w-28 h-28 md:w-36 md:h-36 rounded-2xl border border-neutral-700 shrink-0 shadow-lg shadow-blue-900/20" loading="lazy" />
      <div data-page-intro class="min-w-0 text-left">
        <h1 data-page-title class="text-4xl md:text-5xl font-bold mb-3 bg-gradient-to-r from-blue-500 to-purple-500 bg-clip-text text-transparent">
          AgentStack Daily
        </h1>
        <p class="text-neutral-400 text-lg leading-relaxed max-w-2xl">
          Episódios diários de IA sobre desempenho de LLM, avaliações, notícias de IA,
        IA local, hardware, segurança e o ecossistema AgentStack — novas perspectivas todos os dias.
        </p>
        <div class="mt-3">
          <span class="bg-blue-500/10 border border-blue-500/20 text-blue-300 text-sm px-4 py-1.5 rounded-full inline-block">
            🎤 Anfitriões: Nova &amp; Alloy
          </span>
        </div>
      </div>
    </div>

    <!-- Subscribe Buttons -->
    <div class="mb-10">
      <PodcastSubscribeButtons
        spotifyUrl="https://open.spotify.com/show/3ohlOiRLwQPNMD5JT82vLa"
        appleUrl="https://podcasts.apple.com/us/podcast/openclaw-daily-portugu%C3%AAs/id1879607041"
        pocketcastsUrl="https://pca.st/disimp8x"
        overcastUrl="https://overcast.fm/itunes1879607041"
        amazonUrl="https://music.amazon.com/podcasts/86a6581d-4398-4300-8fe4-94a037722a6f"
        youtubeUrl="https://www.youtube.com/@AgentStackDailyPT"
        client:load
      />
    </div>

    <!-- RSS Feed -->
    <div class="mb-8 bg-blue-500/10 border border-blue-500/30 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <div class="flex-1">
        <p class="text-blue-400 text-sm font-semibold mb-1">📡 RSS Feed</p>
        <code class="text-neutral-300 text-xs break-all select-all">{publicFeedUrl}</code>
      </div>
      <a
        href={publicFeedUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
      >
        Open Feed
      </a>
    </div>

    <!-- Episodes -->
    {fetchError ? (
      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 text-center">
        <p class="text-neutral-400 text-sm">⚠️ Episódios temporariamente indisponíveis. Por favor, volte em breve.</p>
      </div>
    ) : episodes.length === 0 ? (
      <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6 text-center">
        <p class="text-neutral-400 text-sm">Nenhum episódio encontrado no feed ainda.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {episodes.map((ep) => (
          <article class="pa-card bg-neutral-900 border-neutral-800">
            <div class="pa-heading">
              <img
                src={ep.coverImage} {...imageVariants(ep.coverImage, "176px")}
                alt={`Episode ${ep.episodeNum} cover art`}
                class="pa-cover border-neutral-700"
                onerror="this.setAttribute('src', this.getAttribute('src').replace(/_pt.png/,'.png'))"
              />
              <div class="pa-title-wrap">
                <span class="pa-badge bg-blue-400/10 text-blue-400">
                  EP {ep.episodeNum}
                </span>
                <h2 class="pa-title text-white">
                  {ep.title}
                </h2>
              </div>
            </div>
            <p class="pa-summary text-neutral-400">{compactPodcastSummary(ep.description, 180)}</p>
            <p class="pa-meta text-neutral-500">
              <span>{ep.pubDate}</span>
              {ep.duration && (
                <>
                  <span>·</span>
                  <span>⏱ {ep.duration}</span>
                </>
              )}
            </p>
            <div class="pa-actions">
              <a
                href={ep.audioUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="pa-listen text-white"
              >
                🎧 Ouvir
              </a>
              <div class="pa-secondary">
                <a
                  href={`/pt/podcasts/episode-${ep.episodeNum}/`}
                  class="pa-link bg-neutral-800 border-neutral-700 text-neutral-400"
                >
                  📄 Notas do Programa
                </a>
                <a
                  href={`/pt/podcasts/episode-${ep.episodeNum}/#transcript`}
                  class="pa-link bg-neutral-800 border-neutral-700 text-neutral-400"
                >
                  📝 Transcrição
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- Footer note -->
    <p class="text-center text-neutral-600 text-xs mt-12">
      Episódios gerados com fluxos de trabalho de IA agêntica · Vozes por OpenAI TTS
    </p>
  </div>
</Layout>
