---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Central de treinos | Toby on Fitness Tech" description="Explore treinos compartilhados do Speediance ou veja como organizo meu treino." lang="pt" translationBase="/workout-hub/">
  <section class="container mx-auto max-w-4xl px-4 py-14 md:py-20">
    <p class="text-blue-400 font-semibold mb-4">Central de treinos</p>
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-6">Escolha sua próxima sessão</h1>
    <p class="text-lg text-neutral-300 mb-10">Explore treinos compartilhados do Speediance ou veja como organizo meu treino.</p>
    <div class="grid gap-5" data-content-next-step data-analytics-content-type="guide" data-analytics-content-slug={Astro.url.pathname} data-analytics-topic="training" data-analytics-position="guide_directory" data-analytics-item-count="3">
      <a href="/speediance/workouts/" data-content-next-step-item data-analytics-event="content_next_step_click" data-analytics-content-type="guide" data-analytics-content-slug={Astro.url.pathname} data-analytics-topic="training" data-analytics-position="guide_directory" data-analytics-item-position="1" class="rounded-xl bg-blue-600 text-white p-6 text-xl font-semibold">Ver 53 treinos compartilhados →</a>
      <a href="/pt/training/" data-content-next-step-item data-analytics-event="content_next_step_click" data-analytics-content-type="guide" data-analytics-content-slug={Astro.url.pathname} data-analytics-topic="training" data-analytics-position="guide_directory" data-analytics-item-position="2" class="rounded-xl bg-neutral-900 border border-neutral-700 text-white p-6 text-lg">Abordagem de treino →</a>
      <a href="/pt/transformation/" data-content-next-step-item data-analytics-event="content_next_step_click" data-analytics-content-type="guide" data-analytics-content-slug={Astro.url.pathname} data-analytics-topic="training" data-analytics-position="guide_directory" data-analytics-item-position="3" class="rounded-xl bg-neutral-900 border border-neutral-700 text-white p-6 text-lg">Cronologia da transformação →</a>
    </div>
  </section>
</Layout>
