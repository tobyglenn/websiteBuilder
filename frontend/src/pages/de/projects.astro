---
import Layout from '../../layouts/Layout.astro';

const projectGroups = [
  {
    eyebrow: 'Spiele',
    title: 'Spielbare Experimente',
    description: 'Browserspiele und taktische Prototypen, die live genug sind, um sie zu spielen.',
    projects: [
      {
        slug: 'mma-rpg',
        title: 'MMA RPG',
        status: 'Live',
        description: 'Ein rundenbasiertes MMA-Kampf-RPG. Baue deinen Kämpfer auf, meistere Combos und steige in den Rängen auf.',
        href: 'https://clawdassistant85-netizen.github.io/mma-rpg/',
        cta: 'Jetzt spielen',
        tags: ['Kampf', 'RPG', 'Strategie'],
      },
      {
        slug: 'gridbound-realms',
        title: 'Gridbound Realms',
        status: 'Live',
        description: 'Ein taktisches rasterbasiertes Strategiespiel. Befehlige Einheiten, halte die Karte und erobere das Reich.',
        href: 'https://clawdassistant85-netizen.github.io/gridbound-realms/',
        cta: 'Jetzt spielen',
        tags: ['Strategie', 'Taktik', 'Raster'],
      },
    ],
  },
  {
    eyebrow: 'Apps',
    title: 'Trainings- und Ernährungstools',
    description: 'Fitness-Tools, die auf die Workflows zugeschnitten sind, die ich tatsächlich für Mat-Time, Mahlzeiten und Fortschrittsverfolgung verwende.',
    projects: [
      {
        slug: 'bjj-buddy',
        title: 'BJJ Buddy',
        status: 'Live',
        description: 'Eine Brazilian Jiu-Jitsu Tracking-App zum Protokollieren von Rollen, Organisieren von Techniken, Speichern von Favoriten und Verfolgen des Grappling-Fortschritts über die Zeit.',
        href: 'https://bjj-buddy.pages.dev/',
        cta: 'App öffnen',
        tags: ['BJJ', 'Trainingsprotokoll', 'Techniken'],
      },
      {
        slug: 'nutritrack',
        title: 'NutriTrack',
        status: 'Live',
        description: 'Ein kostenloser Ernährungs-Tracker zum Protokollieren von Mahlzeiten, Überwachen von Makros und zum Verknüpfen von Essensdaten mit Trainingszielen.',
        href: 'https://nutritrack.tobyonfitnesstech.com',
        cta: 'Tracker öffnen',
        tags: ['Ernährung', 'Makros', 'Mahlzeitenprotokoll'],
      },
    ],
  },
  {
    eyebrow: 'Kirche',
    title: 'Schrift- und Auswendiglernarbeit',
    description: 'Glaubenstools für Übung, Wiederholung und langfristige Erinnerung.',
    projects: [
      {
        slug: 'one-peter-memory',
        title: '1 Peter Memory Trainer',
        status: 'In Arbeit',
        description: 'Ein KJV-Auswendiglerntrainer für die Alert-Academy-Vorbereitung mit Chunking, Audio-Stimmen, verschwindendem Text, Rezitations-Bewertung und verteilter Wiederholung.',
        href: '/de/one-peter-memory/',
        cta: 'Trainer öffnen',
        tags: ['Bibel', 'Auswendiglernen', 'KJV'],
      },
    ],
  },
  {
    eyebrow: 'Video',
    title: 'Video-Kanäle und kreative Arbeit',
    description: 'Gaming-Videos, Familien-Kreativarbeit und KI-gestützte Story-Serien, wobei jeder Kanal seine eigene Stimme behält.',
    projects: [
      {
        slug: 'lilly',
        title: "Lilly Plays",
        status: 'Aktiv',
        description: "Gaming- und Kreativ-Videos mit Lilly, einschließlich Minecraft, Roblox, AEW und Familienabenteuern. Lilly leitet die Videos; ich helfe beim Schneiden, Untertiteln und Veröffentlichen vollständiger Episoden und Shorts.",
        href: 'https://www.youtube.com/channel/UC7ZfdS-b0zU-cE8Ie6NZVlQ',
        cta: "Lillys Kanal ansehen",
        tags: ['YouTube', 'Gaming', 'Familienabenteuer'],
      },
      {
        slug: 'ironvane',
        title: 'IronVane',
        status: 'Aktiv',
        description: 'Der Crossfire/IronVane Story-Kanal, derzeit zentriert auf Ceryn, Talya und den laufenden Episodenstrang.',
        href: 'https://www.youtube.com/@IronVaneStory/videos',
        cta: 'Serie ansehen',
        tags: ['YouTube', 'Story', 'KI-Video'],
      },
      {
        slug: 'liminal',
        title: 'Liminal',
        status: 'Archiviert',
        description: 'Eine übernatürliche Küstenhotel-Komödienserie. Die Produktion ist pausiert, aber die veröffentlichten Episoden bleiben auf YouTube verfügbar.',
        href: 'https://www.youtube.com/watch?v=Vo_LQS1ubWc',
        cta: 'Liminal ansehen',
        tags: ['YouTube', 'Komödie', 'Archiviert'],
      },
    ],
  },
];

const allProjects = projectGroups.flatMap((group) => group.projects.map((project) => ({
  ...project,
  group: group.eyebrow,
})));

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projekte | Toby on Fitness Tech',
  description: 'Spiele, Trainings-Tools, Bibelübung und Video-Kanäle von Toby on Fitness Tech.',
  url: 'https://tobyonfitnesstech.com/de/projects/',
  hasPart: allProjects.map((project) => ({
    '@type': 'CreativeWork',
    name: project.title,
    url: project.href.startsWith('http') ? project.href : `https://tobyonfitnesstech.com${project.href}`,
    about: project.group,
  })),
};
---

<Layout
  title="Projekte | Toby on Fitness Tech"
  description="Spiele, Trainings-Tools, Bibelübung und Video-Kanäle von Toby on Fitness Tech."
  jsonLd={projectSchema}
  breadcrumbs={[{ name: 'Startseite', url: '/de/' }, { name: 'Projekte', url: '/de/projects/' }]}

  lang="de"
  translationBase="/projects/"
>
  <main class="min-h-screen bg-neutral-950 px-4 py-16 text-white sm:px-6">
    <div class="mx-auto max-w-6xl">
      <header class="border-b border-neutral-800 pb-10">
        <p class="text-sm font-bold uppercase tracking-widest text-blue-400">Projekte</p>
        <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Spiele, Tools und kreative Kanäle</h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-neutral-400">
          Entdecke die Dinge, die ich baue und zum Leben erwecke: spielbare Spiele, Trainings- und Ernährungs-Apps, Bibelübung, Lillys Gaming-Videos und die IronVane/Liminal Story-Arbeit.
        </p>
      </header>

      <nav class="flex flex-wrap gap-3 border-b border-neutral-800 py-5" aria-label="Projektkategorien">
        {projectGroups.map((group) => (
          <a
            href={`#${group.eyebrow.toLowerCase()}`}
            class="rounded-md border border-neutral-800 px-4 py-2 text-sm font-semibold text-neutral-300 transition-colors hover:border-blue-500/60 hover:text-white"
            data-analytics-event="project_category_click"
            data-analytics-content-type="project_category"
            data-analytics-content-slug={group.eyebrow.toLowerCase()}
            data-analytics-content-title={group.title}
          >
            {group.eyebrow}
          </a>
        ))}
      </nav>

      <div class="space-y-14 py-10">
        {projectGroups.map((group) => (
          <section id={group.eyebrow.toLowerCase()} aria-labelledby={`${group.eyebrow.toLowerCase()}-heading`}>
            <div class="mb-6 max-w-3xl">
              <p class="text-xs font-bold uppercase tracking-widest text-neutral-500">{group.eyebrow}</p>
              <h2 id={`${group.eyebrow.toLowerCase()}-heading`} class="mt-2 text-2xl font-bold text-white">{group.title}</h2>
              <p class="mt-2 text-neutral-400">{group.description}</p>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              {group.projects.map((project) => (
                <article
                  id={project.slug}
                  class="flex min-h-full flex-col rounded-lg border border-neutral-800 bg-neutral-900 p-6 transition-colors hover:border-blue-500/50"
                  data-project-card={project.slug}
                  data-analytics-content-title={project.title}
                  data-analytics-position={group.eyebrow.toLowerCase()}
                >
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-2xl font-bold text-white">{project.title}</h3>
                    <span class="shrink-0 rounded-md border border-neutral-700 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-300">
                      {project.status}
                    </span>
                  </div>
                  <p class="mt-4 flex-1 leading-relaxed text-neutral-300">{project.description}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span class="rounded-md bg-neutral-800 px-2.5 py-1 text-xs font-semibold text-neutral-300">{tag}</span>
                    ))}
                  </div>
                  <a
                    href={project.href}
                    target={project.href.startsWith('http') ? '_blank' : undefined}
                    rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="mt-6 inline-flex w-fit items-center gap-2 rounded-md bg-blue-600 px-4 py-2.5 font-semibold text-white transition-colors hover:bg-blue-500"
                    data-analytics-event="project_card_click"
                    data-analytics-content-type="project"
                    data-analytics-content-slug={project.slug}
                    data-analytics-content-title={project.title}
                    data-analytics-position={group.eyebrow.toLowerCase()}
                  >
                    {project.cta}
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>