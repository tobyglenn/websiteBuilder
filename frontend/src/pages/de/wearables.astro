---
import Layout from '../../layouts/Layout.astro';
import { LISTING_BLOG_POSTS } from '../../lib/blogPosts';
import { ArrowRight, BarChart3, HeartPulse, Moon, Scale, Watch } from 'lucide-react';

const wearablePosts = LISTING_BLOG_POSTS
  .filter((post) => /whoop|oura|garmin|wearable|recovery|sleep|hrv/i.test([
    post.title,
    post.excerpt,
    post.category,
    ...(post.tags || []),
  ].join(' ')))
  .sort((a, b) => new Date(b.published_at).getTime() - new Date(a.published_at).getTime());

const preferredSlugs = [
  'whoop-5-not-smaller-review',
  'oura-vs-whoop-sleep-comparison',
  'garmin-and-whoop-what-each-is-actually-for',
  'whoop-recovery-scores-explained',
];

const featuredPosts = preferredSlugs
  .map((slug) => wearablePosts.find((post) => post.slug === slug))
  .filter((post): post is (typeof wearablePosts)[number] => Boolean(post));

for (const post of wearablePosts) {
  if (featuredPosts.length >= 4) break;
  if (!featuredPosts.some((featured) => featured?.slug === post.slug)) featuredPosts.push(post);
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Wearable-Testberichte und Erholungsdaten',
  description: 'Praxisnahe Vergleiche von WHOOP, Oura, Garmin, Schlaf und Erholung, unterstützt durch Toby Peters echte Trainingsdaten.',
  url: 'https://tobyonfitnesstech.com/de/wearables/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: featuredPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://tobyonfitnesstech.com/blog/${post.slug}/`,
      name: post.title,
    })),
  },
};
---

<Layout
  title="Wearable-Testberichte: WHOOP, Oura und Garmin im Vergleich"
  description="Praxisnahe Vergleiche von WHOOP, Oura und Garmin mit Live-Daten zu Erholung, HRV, Schlaf und Training von einem Athleten, der die Geräte zusammen verwendet."
  image="/images/gear/whoop-5.0.jpg"
  jsonLd={articleSchema}
  breadcrumbs={[{ name: 'Startseite', url: '/de/' }, { name: 'Wearables', url: '/de/wearables/' }]}

  lang="de"
  translationBase="/wearables/"
>
  <section class="relative flex min-h-[460px] items-end overflow-hidden border-b border-neutral-800">
    <img
      src="/images/gear/whoop-5.0.jpg"
      alt="WHOOP-Wearable für Tobys Erholungs-Tracking"
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/55 to-transparent"></div>
    <div class="container relative z-10 mx-auto px-4 pb-14 pt-32">
      <div class="max-w-3xl">
        <div class="mb-4 flex items-center gap-2 text-sm font-semibold text-cyan-300">
          <Watch size={18} />
          Unabhängige Wearable-Tests
        </div>
        <h1 class="mb-5 text-4xl font-bold leading-tight text-white md:text-6xl">
          Wearable-Testberichte und Erholungsdaten
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-neutral-200 md:text-xl">
          WHOOP, Oura und Garmin im selben Trainingsalltag getestet. Die Vergleiche hier verbinden Produktaussagen mit Daten zu Schlaf, HRV, Laufen, Krafttraining und BJJ.
        </p>
      </div>
    </div>
  </section>

  <div class="bg-neutral-950">
    <section class="border-b border-neutral-900 py-12">
      <div class="container mx-auto px-4">
        <div class="mb-7 max-w-2xl">
          <p class="mb-2 text-xs font-semibold uppercase text-cyan-400">Beginnen Sie mit der Entscheidung</p>
          <h2 class="text-2xl font-bold text-white md:text-3xl">Was wollen Sie tatsächlich messen?</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <a href="/de/wearables/whoop-5-vs-4-vs-oura/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-cyan-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="whoop-comparison" data-analytics-content-title="WHOOP 5 vs 4 vs Oura">
            <Moon size={22} class="mb-5 text-cyan-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-cyan-300">WHOOP 5 vs 4 vs Oura</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Dicke, Akku, Armbänder, Schlaf, Erholung und die Rolle, die Garmin daneben spielt.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-400">Vergleich öffnen <ArrowRight size={15} /></span>
          </a>
          <a href="/de/blog/garmin-and-whoop-what-each-is-actually-for/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-green-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="training-comparison" data-analytics-content-title="training and running">
            <HeartPulse size={22} class="mb-5 text-green-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-green-300">Training und Laufen</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Garmin für das Workout selbst, WHOOP für die Erholungsreaktion drumherum.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-green-400">Trainingsrollen vergleichen <ArrowRight size={15} /></span>
          </a>
          <a href="/de/compare-trackers/" class="group rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-amber-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="tracker-guide" data-analytics-content-title="choose a tracker">
            <Scale size={22} class="mb-5 text-amber-400" />
            <h3 class="mb-2 font-semibold text-white group-hover:text-amber-300">Ein Gerät auswählen</h3>
            <p class="mb-5 text-sm leading-relaxed text-neutral-400">Nutzen Sie den Tracker-Leitfaden, wenn Budget, Abonnements und Trainingsziele zusammen eine Rolle spielen.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400">Tracker-Leitfaden öffnen <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-neutral-900 py-14">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="mb-2 text-xs font-semibold uppercase text-blue-400">Leser-Leitfäden</p>
            <h2 class="text-2xl font-bold text-white md:text-3xl">Wearable-Vergleiche und Felderfahrungen</h2>
          </div>
          <a href="/de/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300">Alle Artikel <ArrowRight size={15} /></a>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {featuredPosts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="group overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900 hover:border-blue-500/60"
              data-analytics-event="content_card_click"
              data-analytics-content-type="blog"
              data-analytics-content-slug={post.slug}
              data-analytics-content-title={post.title}
            >
              <div class="aspect-video overflow-hidden bg-neutral-800">
                {post.image && <img src={post.image} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />}
              </div>
              <div class="p-5">
                <p class="mb-2 text-xs font-semibold text-blue-400">{post.category}</p>
                <h3 class="mb-3 line-clamp-3 text-sm font-semibold leading-snug text-white group-hover:text-blue-300">{post.title}</h3>
                <p class="line-clamp-3 text-xs leading-relaxed text-neutral-500">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14">
      <div class="container mx-auto grid gap-10 px-4 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase text-emerald-400">Die Zahlen hinter den Testberichten</p>
          <h2 class="mb-4 text-3xl font-bold text-white">Sehen Sie die Erholungsdaten, nicht nur die Produktmeinung</h2>
          <p class="max-w-xl leading-relaxed text-neutral-400">
            Die Live-Seiten zeigen dieselben Erholungs-, Schlaf- und Trainingssignale, die in den Testberichten besprochen werden. So lässt sich erkennen, wie sich die Geräte über echte Wochen verhalten, statt nur in einem kontrollierten Test.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/de/whoop/" class="rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-emerald-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="/de/whoop/" data-analytics-content-title="live WHOOP data">
            <HeartPulse size={22} class="mb-4 text-emerald-400" />
            <h3 class="mb-2 font-semibold text-white">Live-WHOOP-Erholung</h3>
            <p class="mb-4 text-sm text-neutral-400">HRV, Ruhepuls, Schlafleistung und Erholungstrends.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400">Erholungsdaten anzeigen <ArrowRight size={15} /></span>
          </a>
          <a href="/de/sleep/" class="rounded-lg border border-neutral-800 bg-neutral-900 p-6 hover:border-violet-500/60" data-analytics-event="hub_path_selected" data-analytics-content-type="wearables" data-analytics-content-slug="/de/sleep/" data-analytics-content-title="sleep data">
            <BarChart3 size={22} class="mb-4 text-violet-400" />
            <h3 class="mb-2 font-semibold text-white">Schlafdaten</h3>
            <p class="mb-4 text-sm text-neutral-400">Nächtliche Muster und der Erholungskontext rund um die Trainingsbelastung.</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-violet-400">Schlaftrends anzeigen <ArrowRight size={15} /></span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>