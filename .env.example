# Copy to .env and fill in your values (never commit .env)

# Google YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Vizard API key
# Used by scripts/vizard-links.mjs to build captions and optionally publish clips.
VIZARDAI_API_KEY=your_vizard_api_key_here

# Website base URL for full-video links appended to Vizard captions.
SITE_URL_BASE=https://tobyonfitnesstech.com

# PostHog web/product analytics
# The project key is safe to expose in the static site, but keep real values out of git.
PUBLIC_POSTHOG_KEY=phc_replace_with_project_key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity. PUBLIC_CLARITY_ID is safe for the browser bundle.
# CLARITY_API_TOKEN is server-only and must never be exposed to the frontend.
PUBLIC_CLARITY_ID=y4ha1s1t5s
CLARITY_API_TOKEN=

# Workout Hub. Enabled on its own, the page is a static catalogue: it renders the
# curated workouts and their download and share links, and makes no backend call.
PUBLIC_WORKOUT_HUB_ENABLED=false

# Leaderboards and Speediance connect. Both Supabase values are required before
# either appears; without them the hub falls back to the static catalogue above.
# The anon key is meant to ship in the bundle -- row level security is what
# protects the data -- but the service role key must never appear here.
PUBLIC_WORKOUT_HUB_CONNECT=false
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
