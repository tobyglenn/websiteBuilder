+def garmin_sleep_seconds(day_payload):
+    """Prefer the nightly sleep record over the wellness day's sleeping total."""
+    sleep = day_payload.get('sleep') or {}
+    nested = sleep.get('dailySleepDTO') or {}
+    candidates = [sleep.get('sleepTimeSeconds'), nested.get('sleepTimeSeconds'),
+                  (day_payload.get('stats') or {}).get('sleepingSeconds')]
+    for value in candidates:
+        if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0:
+            return value
+    return 0
+
