[Unit]
Description=Local fitness reports for the DGX website data pipeline
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/toby/.openclaw/workspace/scripts/utils/serve_local_fitness_site.py
WorkingDirectory=/home/toby/clawd
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
